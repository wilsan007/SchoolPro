{
  "name": "ecolpro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node scripts/guard-target-db.cjs --quiet && prisma db push",
    "dev:db:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "node scripts/guard-target-db.cjs --quiet && prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/guard-target-db.cjs --quiet && tsx prisma/seed.ts",
    "db:seed:ambouli": "node scripts/guard-target-db.cjs --quiet && tsx prisma/seed-ambouli.ts",
    "db:reset": "node scripts/guard-target-db.cjs --quiet && prisma migrate reset --force",
    "cap:sync": "pnpm exec cap sync",
    "cap:add:ios": "pnpm exec cap add ios",
    "cap:add:android": "pnpm exec cap add android",
    "cap:ios": "pnpm exec cap open ios",
    "cap:android": "pnpm exec cap open android",
    "cap:copy": "pnpm exec cap copy",
    "cap:build:android": "CAP_SERVER_URL=${CAP_SERVER_URL:-https://app.ecolpro.app} pnpm cap:sync && pnpm cap:android",
    "cap:build:ios": "CAP_SERVER_URL=${CAP_SERVER_URL:-https://app.ecolpro.app} pnpm cap:sync && pnpm cap:ios",
    "cap:assets": "npx capacitor-assets generate --android --ios",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:native": "node scripts/generate-native-assets.mjs",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:sites": "tsx scripts/audit-site-isolation.ts",
    "seed:check": "node prisma/sql/generate-sql.mjs && node prisma/sql/_audit/validate.mjs",
    "verify": "pnpm run lint && tsc --noEmit && vitest run",
    "verify:ci": "pnpm run lint && tsc --noEmit && vitest run",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "rls:generate": "node scripts/rls/generate-policies.cjs",
    "rls:check": "node scripts/rls/generate-policies.cjs --check",
    "guard:db": "node scripts/guard-target-db.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/network": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@hookform/resolvers": "^3.9.1",
    "@napi-rs/canvas": "^1.0.5",
    "@otplib/preset-default": "^12.0.1",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@stripe/stripe-js": "^9.9.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/papaparse": "^5.5.2",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.5.20",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.4",
    "otpauth": "^9.5.1",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "resend": "^4.0.1",
    "sharp": "^0.35.0",
    "sonner": "^1.7.2",
    "stripe": "^22.3.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.17",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@cloudflare/containers": "^0.3.7",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.0.1",
    "docx": "^9.7.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.20",
    "eslint-plugin-ecolpro": "file:./eslint-rules",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "postcss": "^8",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
