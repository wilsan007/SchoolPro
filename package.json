{
  "name": "ecolpro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "overrides": {
    "@auth/core": ">=0.41.3",
    "postcss": ">=8.5.18",
    "sharp": ">=0.35.0",
    "next>postcss": ">=8.5.18",
    "tar": "^7.5.16",
    "brace-expansion@>=4.0.0": "5.0.9",
    "uuid@<11.1.1": "11.1.1",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "deepmerge-ts@<8.0.0": "8.0.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint src/",
    "db:push": "node scripts/guard-target-db.cjs --quiet && prisma db push",
    "dev:db:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "node scripts/guard-target-db.cjs --quiet && prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/guard-target-db.cjs --quiet && tsx prisma/seed.ts",
    "db:seed:ambouli": "node scripts/guard-target-db.cjs --quiet && tsx prisma/seed-ambouli.ts",
    "db:reset": "node scripts/guard-target-db.cjs --quiet && prisma migrate reset --force",
    "cap:sync": "pnpm exec cap sync",
    "cap:add:ios": "pnpm exec cap add ios",
    "cap:add:android": "pnpm exec cap add android",
    "cap:ios": "pnpm exec cap open ios",
    "cap:android": "pnpm exec cap open android",
    "cap:copy": "pnpm exec cap copy",
    "cap:build:android": "CAP_SERVER_URL=${CAP_SERVER_URL:-https://app.ecolpro.app} pnpm cap:sync && pnpm cap:android",
    "cap:build:ios": "CAP_SERVER_URL=${CAP_SERVER_URL:-https://app.ecolpro.app} pnpm cap:sync && pnpm cap:ios",
    "cap:assets": "pnpm exec capacitor-assets generate --android --ios",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:native": "node scripts/generate-native-assets.mjs",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:sites": "tsx scripts/audit-site-isolation.ts",
    "seed:check": "node prisma/sql/generate-sql.mjs && node prisma/sql/_audit/validate.mjs",
    "verify": "pnpm run lint && tsc --noEmit && vitest run && pnpm prisma validate && pnpm audit --prod",
    "verify:ci": "pnpm run lint && tsc --noEmit && vitest run && pnpm prisma validate && pnpm audit --prod",
    "verify:quick": "tsc --noEmit && pnpm run lint",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "rls:generate": "node scripts/rls/generate-policies.cjs",
    "rls:check": "node scripts/rls/generate-policies.cjs --check",
    "guard:db": "node scripts/guard-target-db.cjs",
    "audit:full": "node scripts/run-audit.mjs",
    "audit:quick": "node scripts/run-audit.mjs --quick",
    "audit:security": "node scripts/run-audit.mjs --security",
    "audit:sql": "node scripts/run-audit.mjs --sql",
    "audit:deps": "node scripts/run-audit.mjs --deps",
    "audit:types": "pnpm exec type-coverage --strict --at-least 80 --detail",
    "audit:knip": "pnpm exec knip --no-progress",
    "audit:semgrep": "semgrep --config .semgrep.yml .",
    "audit:gitleaks": "gitleaks detect --source . --config .gitleaks.toml --no-banner --verbose",
    "audit:trivy": "trivy fs --severity HIGH,CRITICAL --no-progress .",
    "audit:squawk": "pnpm exec squawk prisma/migrations/",
    "audit:sqlfluff": "sqlfluff lint --config .sqlfluff prisma/migrations/ supabase/",
    "audit:plpgsql": "node scripts/audit-plpgsql.mjs",
    "audit:madge": "pnpm exec madge --circular --extensions ts,tsx src/",
    "audit:depcruise": "pnpm exec dependency-cruiser src --config .dependency-cruiser.cjs",
    "audit:stryker": "pnpm exec stryker run",
    "audit:lighthouse": "pnpm exec lhci autorun --config=./lighthouserc.js",
    "audit:zap": "bash scripts/zap-baseline.sh",
    "audit:axe": "pnpm exec axe-core http://localhost:3000/login --tags wcag2a,wcag2aa,wcag21a,wcag21aa",
    "audit:supabase:types": "source .env && supabase gen types typescript --db-url \"$DIRECT_URL\" --schema public 2>/dev/null | grep -v '^Connecting to' > src/types/supabase-generated.ts",
    "audit:supabase:lint": "supabase db lint",
    "audit:pg:extensions": "docker exec schoolpro-pg-tools psql -U schoolpro -d schoolpro_tools -c \"SELECT extname, extversion FROM pg_extension ORDER BY extname;\"",
    "audit:pg:statements": "docker exec schoolpro-pg-tools psql -U schoolpro -d schoolpro_tools -c \"SELECT query, calls, total_exec_time, mean_exec_time FROM pg_stat_statements ORDER BY total_exec_time DESC LIMIT 20;\"",
    "tools:pg:up": "docker compose -f docker-compose.tools.yml up -d",
    "tools:pg:down": "docker compose -f docker-compose.tools.yml down",
    "tools:pg:reset": "docker compose -f docker-compose.tools.yml down -v && docker compose -f docker-compose.tools.yml up -d"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/network": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@hookform/resolvers": "^3.9.1",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@stripe/stripe-js": "^9.16.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.469.0",
    "next": "^15.5.24",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.4",
    "otpauth": "^9.5.2",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.88.0",
    "recharts": "^2.15.0",
    "resend": "^6.28.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@cloudflare/containers": "^0.3.7",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.6.0",
    "axe-core": "^4.13.0",
    "chromedriver": "^153.0.0",
    "dependency-cruiser": "^18.2.0",
    "docx": "^9.7.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.20",
    "eslint-plugin-ecolpro": "file:./eslint-rules",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "madge": "^8.0.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "prisma": "^6.0.0",
    "squawk-cli": "^2.65.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "type-coverage": "^2.30.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
