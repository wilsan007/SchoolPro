{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/dispatch-scheduled",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/purge-sites",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/purge-audit-logs",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/dispatch",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://ecolpro.app",
    "NEXT_PUBLIC_APP_NAME": "EcolPro"
  }
}
