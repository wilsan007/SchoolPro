[sqlfluff]
dialect = postgres
templater = jinja
rules = all
exclude_rules = L016,L031,L034

[sqlfluff:rules:L010]
capitalisation.identifiers = lowercase

[sqlfluff:rules:L014]
extended_capitalisation.identifiers = lowercase

[sqlfluff:rules:L030]
capitalisation.functions = upper

[sqlfluff:rules:L040]
capitalisation.keywords = upper

[sqlfluff:rules:L042]
require_cte = False

[sqlfluff:rules:layout.long_lines]
max_line_length = 120
