// ============================================================
// VIE SCOLAIRE & DISCIPLINE
// ============================================================

enum TypeIncident {
  RETARD
  BAVARDAGE
  INSOLENCE
  BAGARRE
  TRICHE
  VANDALISM
  ABSENTEISME
  AUTRE
}

enum StatutIncident {
  OUVERT
  EN_TRAITEMENT
  RESOLU
  CLASSE
}

enum TypeSanction {
  AVERTISSEMENT
  BLAME
  EXCLUSION_COURS
  EXCLUSION_TEMP
  CONVOCATION_PARENTS
  TRAVAUX_INTERET_GENERAL
  AUTRE
}

model Incident {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  rapporteParId String?
  rapportePar   User?   @relation("IncidentReporter", fields: [rapporteParId], references: [id])

  type        TypeIncident   @default(AUTRE)
  statut      StatutIncident @default(OUVERT)
  gravite     Int            @default(1) // 1=léger, 2=moyen, 3=grave
  description String
  lieu        String?
  date        DateTime

  sanctions Sanction[]

  notes     String? // notes internes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@map("incidents")
}

model Sanction {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  type          TypeSanction
  description   String?
  dateDebut     DateTime
  dateFin       DateTime?
  parentNotifie Boolean      @default(false)

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@map("sanctions")
}

// ============================================================
// ORIENTATION & PARCOURS ÉLÈVE
// ============================================================

enum TypeRecommandation {
  FILIERE_SCIENTIFIQUE
  FILIERE_LITTERAIRE
  FILIERE_TECHNIQUE
  FILIERE_PROFESSIONNELLE
  REDOUBLEMENT
  SOUTIEN_RENFORCE
  EXCELLENTE_VOIE
}

model ParcoursScolaire {
  id       String @id @default(cuid())
  tenantId String
  eleveId  String
  eleve    Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  annee           String // "2024-2025"
  classe          String // "3ème A"
  niveau          String // "Troisième"
  moyenneAnnuelle Float?
  rang            Int?
  effectif        Int?
  decision        String? // "Passage", "Redoublement", "Diplômé"
  mention         String? // "Très bien", "Bien", "Assez bien", "Passable"

  // Orientation
  recommandation TypeRecommandation?
  commentaire    String?

  createdAt DateTime @default(now())

  @@unique([eleveId, annee])
  @@index([tenantId])
  @@map("parcours_scolaires")
}

// ============================================================
// COMMUNICATION & NOTIFICATIONS
// ============================================================

enum CanalNotification {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum StatutNotification {
  BROUILLON
  PLANIFIEE
  EN_ENVOI
  ENVOYEE
  ECHEC
}

enum CibleNotification {
  TOUS // Toute la communauté
  PARENTS // Tous les parents
  ENSEIGNANTS // Tous les enseignants
  ELEVES // Tous les élèves
  CLASSE // Une classe spécifique
  NIVEAU // Un niveau (ex: Terminale)
}

model Notification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = notification globale (tous sites)
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  titre   String
  contenu String             @db.Text
  canal   CanalNotification  @default(IN_APP)
  statut  StatutNotification @default(BROUILLON)

  cible    CibleNotification @default(TOUS)
  classeId String? // si cible = CLASSE
  niveau   String? // si cible = NIVEAU

  envoyeParId String?
  envoyePar   User?   @relation("NotificationSender", fields: [envoyeParId], references: [id])

  nbDestinataires Int @default(0)
  nbDelivres      Int @default(0)
  nbLus           Int @default(0)

  planifieeAt DateTime? // envoi différé
  envoyeeAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@map("notifications")
}

// ============================================================
// RH & PAIE ENSEIGNANTS
// ============================================================

enum TypeContrat {
  CDI
  CDD
  VACATAIRE
  FONCTIONNAIRE
  STAGIAIRE
}

model FicheRH {
  id           String     @id @default(cuid())
  tenantId     String
  enseignantId String     @unique
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  // Contrat
  typeContrat  TypeContrat @default(CDI)
  dateEntree   DateTime?
  dateSortie   DateTime?
  salaireBase  Float? // en XOF
  tarifHoraire Float? // pour les vacataires

  // Qualifications
  diplome String? // "Master 2", "CAPES"
  echelon Int     @default(1)
  grade   String? // "Professeur certifié"

  // Coordonnées bancaires
  banque String?
  rib    String?
  iban   String?

  // Congés / absences
  congesAnnuels Int @default(30) // jours/an
  congesPris    Int @default(0)
  absencesCount Int @default(0)

  // Notes internes
  evaluation   String? // dernière évaluation
  observations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bulletinsPaie BulletinPaie[]

  @@index([tenantId])
  @@map("fiches_rh")
}

model BulletinPaie {
  id        String  @id @default(cuid())
  ficheRHId String
  ficheRH   FicheRH @relation(fields: [ficheRHId], references: [id], onDelete: Cascade)

  mois             Int // 1-12
  annee            Int
  heuresEffectuees Float     @default(0)
  salaireBase      Float     @default(0)
  primes           Float     @default(0)
  deductions       Float     @default(0)
  netAPayer        Float     @default(0)
  isPaye           Boolean   @default(false)
  datePaiement     DateTime?
  reference        String?

  createdAt DateTime @default(now())

  @@unique([ficheRHId, mois, annee])
  @@map("bulletins_paie")
}

// ============================================================
// ABSENCES & CONGÉS DU PERSONNEL
// ============================================================

enum TypeAbsencePersonnel {
  ABSENCE
  RETARD
  MISSION
  FORMATION
  MALADIE
  AUTRE
}

enum StatutAbsencePersonnel {
  EN_ATTENTE
  JUSTIFIEE
  INJUSTIFIEE
}

model AbsencePersonnel {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  date       DateTime
  heureDebut String? // null = journée entière
  heureFin   String?

  type        TypeAbsencePersonnel @default(ABSENCE)
  statut      StatutAbsencePersonnel @default(EN_ATTENTE)
  motif       String?
  justificatif String? // URL document
  commentaire  String?

  saisieParId String? // userId
  saisiePar   User?   @relation("AbsencePersonnelSaisiePar", fields: [saisieParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([enseignantId])
  @@index([tenantId, date])
  @@map("absences_personnel")
}

enum StatutConge {
  DEMANDE // En attente d'approbation
  APPROUVE
  REFUSE
  EN_COURS
  TERMINE
  ANNULE
}

enum TypeConge {
  ANNUEL
  MALADIE
  SPECIAL
  MATERNITE
  PATERNITE
  SANS_SOLDE
  AUTRE
}

model CongePersonnel {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  type      TypeConge @default(ANNUEL)
  statut    StatutConge @default(DEMANDE)

  dateDebut DateTime
  dateFin   DateTime
  nbJours   Float // calculé ou saisi

  motif     String?
  justificatif String? // URL document

  demandeParId  String? // userId
  demandePar    User?   @relation("CongeDemandePar", fields: [demandeParId], references: [id], onDelete: SetNull)
  approuveParId String? // userId
  approuvePar   User?   @relation("CongeApprouvePar", fields: [approuveParId], references: [id], onDelete: SetNull)
  approuveAt    DateTime?

  commentaire String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([enseignantId])
  @@index([tenantId, statut])
  @@map("conges_personnel")
}

// ============================================================
// ADMISSIONS & INSCRIPTIONS
// ============================================================

enum StatutCandidature {
  SOUMISE // Candidature reçue, en attente de traitement
  EN_EXAMEN // Dossier en cours d'examen
  ADMIS // Candidat admis
  REFUSE // Candidature refusée
  INSCRIT // Passage en inscription confirmée
  ANNULE // Candidature annulée
}

model Candidature {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = candidature non rattachée à un site
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Informations élève
  nom           String
  prenom        String
  dateNaissance DateTime
  lieuNaissance String?
  sexe          Sexe     @default(M)
  nationalite   String?  @default("SN")
  photoUrl      String?

  // Scolarité souhaitée
  classeVoulue String // "6ème", "Terminale S"
  annee        String // "2026-2027"

  // Contacts parents
  parentNom    String
  parentPrenom String
  parentEmail  String?
  parentPhone  String
  parentLien   LienParente @default(PERE)

  // Statut & workflow
  statut      StatutCandidature @default(SOUMISE)
  dateExamen  DateTime? // date de l'examen d'entrée
  noteExamen  Float? // note obtenue à l'examen
  commentaire String? // notes internes admin
  motifRefus  String?

  // Documents joints (URLs)
  documents Json? // [{ nom: "Bulletin", url: "..." }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, statut])
  @@index([siteId])
  @@map("candidatures")
}

// ============================================================
// ALUMNI (Anciens élèves)
// ============================================================

enum StatutAlumni {
  ETUDES_SUPERIEURES
  EN_EMPLOI
  RECHERCHE_EMPLOI
  ENTREPRENEUR
  INCONNU
}

model Alumni {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Infos identité (copie depuis Eleve si existant)
  eleveId       String? // lien optionnel vers l'élève source
  nom           String
  prenom        String
  email         String?
  telephone     String?
  photoUrl      String?
  sexe          Sexe      @default(M)
  dateNaissance DateTime?

  // Parcours scolaire dans l'établissement
  anneeDiplome  String // "2024-2025"
  classeDepart  String // "Terminale S"
  mention       String? // "Très Bien"
  numeroDiplome String?

  // Situation actuelle
  statut        StatutAlumni @default(INCONNU)
  etablissement String? // Université / Entreprise
  formation     String? // Filière / Poste
  ville         String?
  pays          String?

  // Réseau
  linkedin       String?
  accepteContact Boolean @default(true)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@map("alumni")
}

// ============================================================
// INVENTAIRE (Matériel & Ressources)
// ============================================================

enum EtatItem {
  NEUF
  BON
  USE
  ENDOMMAGE
  HORS_SERVICE
}

enum CategorieItem {
  INFORMATIQUE // Ordinateurs, tablettes, vidéoprojecteurs
  MOBILIER // Tables, chaises, armoires
  SPORTIF // Équipement sportif
  PEDAGOGIQUE // Manuels, fournitures
  AUDIOVISUEL // Écrans, micros, enceintes
  ENTRETIEN // Produits, matériel ménage
  SECURITE // Extincteurs, caméras
  AUTRE
}

model ItemInventaire {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  nom         String
  description String?
  reference   String? // code interne / numéro de série
  categorie   CategorieItem @default(AUTRE)
  etat        EtatItem      @default(BON)
  quantite    Int           @default(1)
  quantiteMin Int           @default(0) // seuil alerte stock

  localisation String? // "Salle informatique A", "Magasin"
  fournisseur  String?
  prixUnitaire Float?
  devise       String  @default("DJF")

  dateAchat    DateTime?
  dateGarantie DateTime?
  dateRevision DateTime? // prochaine révision/maintenance

  photoUrl String?
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@map("inventaire")
}

// ============================================================
// MESSAGERIE INTERNE
// ============================================================

enum ConversationType {
  DIRECT              // 1-to-1 libre
  CLASS_ANNOUNCEMENT  // Admin/enseignant → classe (lecture seule par défaut)
  CLASS_DISCUSSION    // Enseignant ↔ classe (élèves/parents peuvent répondre)
  ADMIN_BROADCAST     // Admin → tout le tenant/site
  PARENT_TEACHER      // Parent ↔ enseignant (lié via élève)
  PARENT_ADMIN        // Parent ↔ administration
  STAFF_GROUP         // Groupe d'enseignants/personnel
  FREE                // Groupe libre (exception)
}

enum ParticipantRole {
  ADMIN     // Modérateur: peut écrire, modérer, supprimer
  MEMBER    // Participant actif: peut écrire
  READONLY  // Lecture seule uniquement
}

model Conversation {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    String?
  isGroup    Boolean          @default(false)
  type       ConversationType @default(DIRECT)
  classeId   String?          // lié à une classe (CLASS_ANNOUNCEMENT, CLASS_DISCUSSION)
  classe     Classe?          @relation("ConversationClasse", fields: [classeId], references: [id], onDelete: SetNull)
  siteId     String?          // filtrage multi-site
  site       Site?            @relation("ConversationSite", fields: [siteId], references: [id], onDelete: SetNull)
  createdBy  String           // userId du créateur
  creator    User             @relation("ConversationCreator", fields: [createdBy], references: [id])
  readOnly   Boolean          @default(false)  // annonce: seul l'admin/creator écrit
  pinned     Boolean          @default(false)  // épinglé en haut de la liste

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([classeId])
  @@index([siteId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      ParticipantRole @default(MEMBER)  // ADMIN, MEMBER, READONLY
  joinedAt  DateTime        @default(now())
  lastReadAt DateTime?

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  content        String
  readBy         String[] // array of userIds
  replyToId      String?  // réponse à un message (thread)
  replyTo        Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReply")

  attachmentUrl  String?
  attachmentType String?  // image, file, pdf...

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

// ============================================================
// APPAREILS MOBILES (tokens push APNs / FCM)
// ============================================================

enum PlatformMobile {
  IOS
  ANDROID
  WEB
}

model DeviceToken {
  id       String  @id @default(cuid())
  tenantId String?
  userId   String
  user     User    @relation("UserDevices", fields: [userId], references: [id], onDelete: Cascade)

  token    String         @unique // token APNs / FCM
  platform PlatformMobile @default(ANDROID)
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@map("device_tokens")
}

// ============================================================
// LMS — E-LEARNING (Module M16)
// ============================================================

enum NiveauCours {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum StatutCours {
  BROUILLON
  PUBLIE
  ARCHIVE
}

enum TypeContenu {
  VIDEO // Lien YouTube / Vimeo
  DOCUMENT // PDF, Word, etc.
  LIEN // URL externe
  TEXTE // Contenu riche en texte
  QUIZ // QCM interactif
}

model Cours {
  id       String @id @default(cuid())
  tenantId String

  siteId String? // null = cours partagé entre tous les sites
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  titre       String
  description String?     @db.Text
  niveau      NiveauCours @default(INTERMEDIAIRE)
  statut      StatutCours @default(BROUILLON)

  // Cible pédagogique
  matiereNom String? // matière concernée (libre)
  classeNom  String? // classe cible (libre, ex: "Terminale S")
  auteurNom  String? // nom de l'enseignant auteur

  // Médias
  imageUrl String? // image de couverture
  dureeMin Int? // durée estimée en minutes

  // Compteurs
  nbVues     Int @default(0)
  nbInscrits Int @default(0)

  contenus     ContenuCours[]
  progressions ProgressionEleve[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@map("cours")
}

model ContenuCours {
  id      String @id @default(cuid())
  coursId String
  cours   Cours  @relation(fields: [coursId], references: [id], onDelete: Cascade)

  titre String
  type  TypeContenu @default(TEXTE)
  ordre Int         @default(0)

  // Contenu selon le type
  url      String? // pour VIDEO, DOCUMENT, LIEN
  texte    String? @db.Text // pour TEXTE, QUIZ (JSON pour quiz)
  dureeMin Int? // durée estimée en minutes

  isGratuit Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([coursId])
  @@map("contenus_cours")
}

model ProgressionEleve {
  id      String @id @default(cuid())
  coursId String
  cours   Cours  @relation(fields: [coursId], references: [id], onDelete: Cascade)

  eleveNom String // nom complet de l'élève
  eleveId  String? // lien optionnel vers le modèle Eleve

  // Progression
  contenusVus   String[] // IDs des contenus vus
  pctCompletion Int       @default(0) // 0-100%
  noteFinale    Float? // note obtenue si quiz/examen final
  isTermine     Boolean   @default(false)
  termineeAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coursId, eleveNom])
  @@map("progressions_eleves")
}

// ============================================================
// RÈGLES D'APPRÉCIATION CONFIGURABLES (Phase 3 — MENFOP)
// ============================================================

enum ContexteAppreciation {
  NOTE_MATIERE
  BULLETIN_PERIODE
  BULLETIN_ANNUEL
  ABSENCE
}

model ReglesAppreciation {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contexte  ContexteAppreciation
  seuilMin  Float
  seuilMax  Float
  libelle   String
  ordre     Int                   @default(0)

  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([tenantId, contexte])
  @@map("regles_appreciation")
}

// ============================================================
// DISPENSE DE MATIÈRE (exempter un élève d'une matière)
// ============================================================

model DispenseMatiere {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId   String
  eleve     Eleve   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  periodeId String?
  motif     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eleveId, matiereId, periodeId])
  @@index([tenantId])
  @@index([eleveId])
  @@map("dispenses_matiere")
}

// ============================================================
// AUDIT & TRAÇABILITÉ
// ============================================================

enum AuditVerdict {
  ALLOWED
  DENIED
}

model AuditLog {
  id         String       @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  verdict    AuditVerdict
  resource   String?
  resourceId String?
  reason     String?
  metadata   Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([verdict])
  @@index([createdAt])
  @@map("audit_logs")
}
