// ============================================================
// EcolPro — Schéma Prisma Multi-Tenant
// Strategy: Row-level isolation via tenantId sur toutes les tables
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // Prisma >= 5.9.0: prepared statements sont activés par défaut
  // sauf si pgbouncer=true dans l'URL (mode transaction).
  // Pour les activer explicitement en mode session, utiliser:
  // relationMode = "foreignKeys" (déjà le défaut)
}

// ============================================================
// PLANS & ABONNEMENTS
// ============================================================

enum PlanType {
  STARTER // < 200 élèves — 49€/mois
  PRO // 200-1000 élèves — 149€/mois
  BUSINESS // 1000-5000 élèves — 399€/mois
  ENTERPRISE // > 5000 élèves — sur devis
}

enum TenantStatus {
  TRIAL // Période d'essai (30 jours)
  ACTIVE // Abonnement actif
  SUSPENDED // Suspendu (impayé)
  CANCELLED // Résilié
}

// Modèle de nommage des niveaux scolaires
enum ModeleNiveaux {
  ANNEES // 1ère année → 9ème année, Seconde, 1ère, Terminale (défaut, déjà en DB)
  FRANCAIS // CI, CP, CE1, CE2, CM1, CM2, 6ème → 3ème, 2nde, 1ère, Terminale
}

// ============================================================
// TENANT (Établissement scolaire)
// ============================================================

model Tenant {
  id          String       @id @default(cuid())
  name        String // "Lycée Omar Bongo"
  slug        String       @unique // "lycee-omar-bongo" → sous-domaine
  domain      String?      @unique // domaine personnalisé optionnel
  logoUrl     String?
  plan        PlanType     @default(STARTER)
  status      TenantStatus @default(TRIAL)
  trialEndsAt DateTime?

  // Informations légales
  address String?
  city    String?
  country String  @default("SN") // Code ISO pays
  phone   String?
  email   String?
  website String?
  siret   String? // Numéro d'agrément

  // Configuration pédagogique
  currentYear   String        @default("2025-2026")
  notationMax   Int           @default(20) // Notation sur 20 ou 100
  langue        String        @default("fr")
  timezone      String        @default("Africa/Dakar")
  currency      String        @default("XOF") // Franc CFA
  modeleNiveaux ModeleNiveaux @default(ANNEES) // Système de nommage des niveaux

  // Couleurs de marque
  primaryColor   String?
  secondaryColor String?

  // Signature & cachet pour documents officiels (bulletins, attestations)
  signatureUrl      String?
  cachetUrl         String?
  chefEtablissement String?

  // Stripe
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                 User[]
  userTenants           UserTenant[]
  userRoles             UserRole[]
  userPermissions       UserPermission[]
  annees                AnneesScolaires[]
  campagnesReinscription CampagneReinscription[]
  classes               Classe[]
  matieres              Matiere[]
  eleves                Eleve[]
  parents               Parent[]
  enseignants           Enseignant[]
  absences              Absence[]
  notes                 Note[]
  examens               Examen[]
  factures              Facture[]
  evenements            Evenement[]
  incidents             Incident[]
  candidatures          Candidature[]
  inscriptionHistorique InscriptionHistorique[]
  notifications         Notification[]
  alumni                Alumni[]
  inventaire            ItemInventaire[]
  evaluations           Evaluation[]
  disponibilites        DisponibiliteEnseignant[]
  indisponibilites      IndisponibiliteEnseignant[]
  salles                Salle[]
  sites                 Site[]
  structures            Structure[]
  reglesAppreciation    ReglesAppreciation[]
  dispenses             DispenseMatiere[]
  absencesPersonnel     AbsencePersonnel[]
  congesPersonnel       CongePersonnel[]
  conversations         Conversation[]
  tarifsNiveau          TarifNiveau[]
  relances              Relance[]
  exclusionsEleve       ExclusionEleve[]
  progressionsEleves    ProgressionEleve[]

  // INFIRMERIE
  passagesInfirmerie PassageInfirmerie[]
  fichesSanitaires   FicheSanitaire[]

  // LEARNOS
  learnosChapitres                 Chapitre[]
  learnosCompetences               Competence[]
  learnosEvidences                 LearningEvidence[]
  learnosProfils                   StudentLearningProfile[]
  learnosInterventions             StudentIntervention[]
  learnosAiDecisions               AiDecisionLog[]
  learnosEvents                    LearnosEvent[]
  learnosEvalCompetences           EvaluationCompetence[]
  learnosSeuils                    SeuilsRecommandation[]
  learnosRecommandations           Recommandation[]
  learnosPlans                     PlanProgression[]
  learnosPlanifications            PlanificationChapitre[]
  learnosPlanificationsCompetences PlanificationCompetence[]
  learnosKpis                      KpiSnapshot[]
  learnosQuestions                 Question[]
  learnosAlertesParent             AlerteParent[]
  learnosEchangesParent            EchangeParent[]
  learnosPreferencesParent         PreferencesParent[]
  learnosFeuilles                  FeuilleExercices[]
  learnosPatterns                  PatternPedagogique[]
  learnosPredictions               PredictionDifficulte[]
  learnosCalibrations              CalibrationSeuil[]
  learnosJournal                   JournalApprentissage[]
  learnosPlansLecon                PlanLecon[]
  learnosRubriques                 RubriqueEvaluation[]

  // Modules activables
  modulesActives ModuleActivation[]

  // Gouvernance
  conseils    Conseil[]
  resolutions Résolution[]

  // Mentorat
  mentorats Mentorat[]

  // CAHIER DE TEXTES & REMPLACEMENTS & ENTRETIENS
  devoirs              Devoir[]
  remplacementsCours   RemplacementCours[]
  entretiensConseiller EntretienConseiller[]
  seancesPedagogiques  SeancePedagogique[]

  // Self-service : demandes de rattachement parent↔élève
  demandesLienParent DemandeLienParent[]

  // BUDGET & DÉPENSES
  budgets  Budget[]
  depenses Depense[]

  // TÂCHES du personnel
  taches Tache[]

  // Synchronisation locale (sauvegarde automatique sur PC du principal)
  syncConfig SyncConfig?

  // REMISES DE CAISSE
  remisesCaisse RemiseCaisse[]

  // AFFECTATIONS ENSEIGNANTS
  affectationsEnseignants AffectationEnseignant[]

  // FOURNITURES SCOLAIRES
  demandesFournitures DemandeFourniture[]
  listesFournitures   ListeFournitureClasse[]

  @@map("tenants")
}

// ============================================================
// SYNCHRONISATION LOCALE — Sauvegarde automatique sur PC
// ============================================================

/// Configuration de la synchronisation entre la plateforme cloud et
/// un serveur local (PC du principal). L'agent local télécharge
/// périodiquement un export complet des données sous forme de fichiers
/// Excel, garantissant que l'établissement conserve ses données même
/// en cas de panne ou de départ de la plateforme.
model SyncConfig {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nom convivial du serveur local (ex: "PC-Directeur-Mariam")
  serverNick String

  /// Intervalle de synchronisation en minutes (30 ou 60)
  syncInterval Int @default(60)

  /// Active ou désactive la synchronisation automatique
  syncEnabled Boolean @default(true)

  /// Clé API unique pour authentifier l'agent local
  apiKey String @unique

  /// Dernière synchronisation réussie
  lastSyncAt DateTime?

  /// Statut de la dernière sync: "SUCCESS" | "FAILED" | "PARTIAL"
  lastSyncStatus String?

  /// Message d'erreur éventuel de la dernière sync
  lastSyncError String?

  /// Inclure les bulletins dans l'export
  includeBulletins    Boolean @default(true)
  /// Inclure les notes détaillées
  includeNotes        Boolean @default(true)
  /// Inclure l'emploi du temps
  includeEmploiTemps  Boolean @default(true)
  /// Inclure les examens planifiés
  includeExamens      Boolean @default(true)
  /// Inclure le personnel et enseignants
  includePersonnel    Boolean @default(true)
  /// Inclure la comptabilité (factures, paiements, échéanciers)
  includeComptabilite Boolean @default(true)
  /// Inclure les absences élèves
  includeAbsences     Boolean @default(true)
  /// Inclure les paramètres de l'établissement
  includeParametres   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sync_configs")
}

// ============================================================
// GOUVERNANCE
// ============================================================

/// Conseil d'administration ou instance de gouvernance d'un tenant.
/// Un tenant peut avoir plusieurs instances (CA, conseil de discipline,
/// conseil pédagogique, etc.).
model Conseil {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nom         String // "Conseil d'administration", "Conseil de discipline"
  type        String // "ADMINISTRATION" | "DISCIPLINE" | "PEDAGOGIQUE" | "AUTRE"
  description String?

  /// Fréquence des réunions : "MENSUEL" | "TRIMESTRIEL" | "ANNUEL" | "PONCTUEL"
  frequence String @default("TRIMESTRIEL")

  membres     MembreConseil[]
  reunions    Réunion[]
  resolutions Résolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("conseils")
}

/// Membre d'un conseil de gouvernance.
model MembreConseil {
  id        String  @id @default(cuid())
  conseilId String
  conseil   Conseil @relation(fields: [conseilId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Rôle dans le conseil : "PRESIDENT" | "SECRETAIRE" | "MEMBRE" | "OBSERVATEUR"
  role String @default("MEMBRE")

  /// Nom affiché si pas d'utilisateur lié (membre externe)
  nomExterne String?

  /// Date de début et fin de mandat
  debutMandat DateTime?
  finMandat   DateTime?

  createdAt DateTime @default(now())

  @@index([conseilId])
  @@index([userId])
  @@map("membres_conseil")
}

/// Réunion d'un conseil.
model Réunion {
  id        String  @id @default(cuid())
  conseilId String
  conseil   Conseil @relation(fields: [conseilId], references: [id], onDelete: Cascade)

  titre String
  date  DateTime
  lieu  String?

  /// Ordre du jour (liste de points)
  ordreDuJour String?

  /// "PLANIFIEE" | "EN_COURS" | "TERMINEE" | "ANNULEE"
  statut String @default("PLANIFIEE")

  /// Compte-rendu (texte libre)
  compteRendu String?

  /// Présences (JSON : array of { userId, present })
  presences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conseilId])
  @@index([date])
  @@map("reunions")
}

/// Résolution adoptée par un conseil.
model Résolution {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conseilId String?
  conseil   Conseil? @relation(fields: [conseilId], references: [id], onDelete: SetNull)

  titre       String
  description String?

  /// "ADOPTÉE" | "REJETÉE" | "EN_ATTENTE" | "RETIRÉE"
  statut String @default("EN_ATTENTE")

  /// Date de vote
  dateVote DateTime?

  /// Résultats du vote (JSON : { pour, contre, abstentions })
  resultats Json?

  /// Date d'effet
  dateEffet DateTime?

  /// Date de fin d'application (null = indéterminée)
  dateFin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([conseilId])
  @@map("resolutions")
}

// ============================================================
// MENTORAT
// ============================================================

/// Relation de mentorat entre un mentor (enseignant ou membre externe)
/// et un mentoré (élève, enseignant junior, ou tout autre utilisateur).
model Mentorat {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Mentor — utilisateur qui accompagne
  mentorId String
  mentor   User   @relation("MentoratMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  /// Mentoré — utilisateur accompagné
  mentoreId String
  mentore   User   @relation("MentoratMentore", fields: [mentoreId], references: [id], onDelete: Cascade)

  /// Type de mentorat : "ACADEMIQUE" | "PROFESSIONNEL" | "PERSONNEL"
  type String @default("ACADEMIQUE")

  /// "ACTIF" | "SUSPENDU" | "TERMINE" | "ANNULE"
  statut String @default("ACTIF")

  /// Période de mentorat
  dateDebut DateTime  @default(now())
  dateFin   DateTime?

  /// Fréquence des rencontres : "HEBDOMADAIRE" | "BIHEBDOMADAIRE" | "MENSUEL" | "PONCTUEL"
  frequence String @default("MENSUEL")

  /// Notes générales sur la relation de mentorat
  notes String?

  objectifs ObjectifMentorat[]
  seances   SeanceMentorat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mentorId, mentoreId])
  @@index([tenantId])
  @@index([mentorId])
  @@index([mentoreId])
  @@map("mentorats")
}

/// Objectif défini dans le cadre d'un mentorat.
model ObjectifMentorat {
  id         String   @id @default(cuid())
  mentoratId String
  mentorat   Mentorat @relation(fields: [mentoratId], references: [id], onDelete: Cascade)

  titre       String
  description String?

  /// "EN_COURS" | "ATTEINT" | "NON_ATTEINT" | "ABANDONNE"
  statut String @default("EN_COURS")

  /// Priorité : 1 (haute) à 5 (basse)
  priorite Int @default(3)

  /// Date cible d'atteinte
  dateCible DateTime?

  /// Progression : 0 à 100
  progression Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentoratId])
  @@map("objectifs_mentorat")
}

/// Séance de mentorat — rencontre entre mentor et mentoré.
model SeanceMentorat {
  id         String   @id @default(cuid())
  mentoratId String
  mentorat   Mentorat @relation(fields: [mentoratId], references: [id], onDelete: Cascade)

  date  DateTime
  duree Int? // en minutes

  /// "PLANIFIEE" | "EFFECTUEE" | "ANNULEE" | "REPORTÉE"
  statut String @default("PLANIFIEE")

  /// Compte-rendu de la séance
  compteRendu String?

  /// Lieu ou lien visio
  lieu String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentoratId])
  @@index([date])
  @@map("seances_mentorat")
}

/// Catalogue des modules disponibles dans l'application.
/// Un module est une fonctionnalité optionnelle qu'un tenant peut
/// activer ou désactiver selon son plan ou ses besoins.
/// Exemples : LEARNOS, MESSAGERIE, RH, INVENTAIRE, ALUMNI, ORIENTATION…
model Module {
  id          String  @id @default(cuid())
  code        String  @unique // "LEARNOS", "MESSAGERIE", "RH"…
  nom         String // nom affiché (clé de traduction : module.{code}.nom)
  description String?

  /// Plan minimum requis pour ce module
  planMinimum PlanType @default(STARTER)

  /// Module activé par défaut pour les nouveaux tenants
  actifParDefaut Boolean @default(false)

  /// Module payant (nécessite un abonnement spécifique)
  payant Boolean @default(false)

  /// Prix mensuel optionnel si le module est payant séparément
  prixMensuel Float?

  /// Ordre d'affichage dans la liste des modules
  ordre Int @default(0)

  activations ModuleActivation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

/// Activation d'un module pour un tenant spécifique.
/// Permet de suivre quand un module a été activé, par qui, et
/// s'il est actuellement actif ou désactivé.
model ModuleActivation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  /// ACTIF | DESACTIVE | ESSAI
  statut String @default("ACTIF")

  /// Date d'activation
  activeAt DateTime @default(now())

  /// Date de désactivation (null si actif)
  desactiveAt DateTime?

  /// Utilisateur qui a activé/désactivé
  activeParId    String?
  desactiveParId String?

  /// Date de fin d'essai (si statut = ESSAI)
  finEssaiAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
  @@map("module_activations")
}

// ============================================================
// SITES / CAMPUSES (multi-sites au sein d'un même tenant)
// ============================================================

model Site {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nom       String // "Campus Central", "Annexe PK12"
  code      String? // "SITE-01"
  adresse   String?
  ville     String?
  telephone String?
  email     String?
  actif     Boolean @default(true)

  classes                    Classe[]
  salles                     Salle[]
  factures                   Facture[]
  users                      User[]
  eleves                     Eleve[]
  examens                    Examen[]
  evenements                 Evenement[]
  notifications              Notification[]
  candidatures               Candidature[]
  alumni                     Alumni[]
  inventaire                 ItemInventaire[]
  cours                      Cours[]
  matieres                   Matiere[]
  structures                 Structure[]
  disponibilitesEnseignant   DisponibiliteEnseignant[]
  indisponibilitesEnseignant IndisponibiliteEnseignant[]
  conversations              Conversation[]              @relation("ConversationSite")

  // Enseignants multi-sites
  enseignantSites EnseignantSite[]

  // Users multi-sites
  userSites UserSite[]

  // Tarifs par niveau
  tarifsNiveau TarifNiveau[]

  // LEARNOS
  learnosChapitres                 Chapitre[]
  learnosCompetences               Competence[]
  learnosEvidences                 LearningEvidence[]
  learnosProfils                   StudentLearningProfile[]
  learnosInterventions             StudentIntervention[]
  learnosAiDecisions               AiDecisionLog[]
  learnosEvents                    LearnosEvent[]
  learnosEvalCompetences           EvaluationCompetence[]
  learnosSeuils                    SeuilsRecommandation[]
  learnosRecommandations           Recommandation[]
  learnosPlans                     PlanProgression[]
  learnosPlanifications            PlanificationChapitre[]
  learnosPlanificationsCompetences PlanificationCompetence[]
  learnosKpis                      KpiSnapshot[]
  learnosQuestions                 Question[]
  learnosAlertesParent             AlerteParent[]
  learnosEchangesParent            EchangeParent[]
  // Pas de `PreferencesParent` ici : les préférences appartiennent à la
  // famille, pas au site. Un parent dont l'enfant change d'établissement
  // garde son consentement et sa langue.
  learnosFeuilles                  FeuilleExercices[]
  learnosPatterns                  PatternPedagogique[]
  learnosPredictions               PredictionDifficulte[]
  learnosCalibrations              CalibrationSeuil[]
  learnosJournal                   JournalApprentissage[]
  learnosPlansLecon                PlanLecon[]
  learnosRubriques                 RubriqueEvaluation[]

  // Infirmerie & santé
  passagesInfirmerie PassageInfirmerie[]
  fichesSanitaires   FicheSanitaire[]

  // Cahier de textes & remplacements & entretiens
  devoirs              Devoir[]
  remplacementsCours   RemplacementCours[]
  entretiensConseiller EntretienConseiller[]
  seancesPedagogiques  SeancePedagogique[]

  // BUDGET & DÉPENSES
  budgets  Budget[]
  depenses Depense[]

  // TÂCHES du personnel
  taches Tache[]

  // REMISES DE CAISSE
  remisesCaisse RemiseCaisse[]

  // FOURNITURES SCOLAIRES
  demandesFournitures DemandeFourniture[]
  listesFournitures   ListeFournitureClasse[]

  // Soft-delete / purge planifiée (Option B — industry standard)
  deletedAt        DateTime?
  deletedBy        String?
  deletedReason    String?
  scheduledPurgeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("sites")
}

// ============================================================
// JOURNAL D'AUDIT — SUPPRESSION DE SITES
// Conserve une trace permanente même après purge définitive.
// ============================================================

model SiteDeletionLog {
  id              String   @id @default(cuid())
  tenantId        String
  siteId          String
  siteNom         String
  action          String // "SOFT_DELETE" | "RESTORE" | "PURGE"
  reason          String?
  performedBy     String
  performedByName String?
  performedAt     DateTime @default(now())
  metadata        Json?

  @@index([tenantId])
  @@index([siteId])
  @@map("site_deletion_logs")
}

// Table de liaison User ↔ Site (accès multi-sites pour tout utilisateur)
model UserSite {
  id     String @id @default(cuid())
  userId String
  siteId String
  role   Role? // null = hérite du rôle global (User.role)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime?

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
  @@map("user_sites")
}

// Table de liaison pour les enseignants qui travaillent sur plusieurs sites
model EnseignantSite {
  id           String @id @default(cuid())
  enseignantId String
  siteId       String

  enseignant Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([enseignantId, siteId])
  @@index([enseignantId])
  @@index([siteId])
  @@map("enseignant_sites")
}

// ============================================================
// ANNÉE SCOLAIRE
// ============================================================

model AnneesScolaires {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  libelle   String // "2025-2026"
  dateDebut DateTime
  dateFin   DateTime
  isCurrent Boolean  @default(false)

  // Clôture / archivage d'année
  statut      String    @default("OUVERTE") // OUVERTE | CLOTUREE | ARCHIVEE
  cloturedAt  DateTime?
  archiveeAt  DateTime?
  cloturePar  String? // ID utilisateur qui a clôturé
  archiveePar String? // ID utilisateur qui a archivé

  periodes                  Periode[]
  evenements                EvenementCalendaire[]
  learnosPlanifications     PlanificationChapitre[]
  planificationsCompetences PlanificationCompetence[]
  factures                  Facture[]

  @@index([tenantId])
  @@index([tenantId, statut])
  @@map("annees_scolaires")
}

// ============================================================
// CAMPAGNE DE RÉINSCRIPTION
// ============================================================

/// Campagne annuelle orchestrant la transition d'une année à la suivante.
///
/// Le wizard 6 étapes (préparation → clôture → promotion → réinscriptions →
/// frais → activation) suit et guide l'administrateur tout au long du processus.
model CampagneReinscription {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  libelle     String // "Réinscription 2026-2027"
  anneeSource String // "2025-2026"
  anneeCible  String // "2026-2027"

  /// BROUILLON | EN_COURS | TERMINEE | ANNULEE
  statut      String   @default("BROUILLON")

  /// Étape actuelle du wizard (1-6)
  etapeActuelle Int    @default(1)

  /// Pré-calculs stockés pour le dashboard
  nbElevesTotal     Int @default(0)
  nbReinscrits      Int @default(0)
  nbNonReinscrits   Int @default(0)
  nbDiplomes        Int @default(0)
  revenusPrevus     Float @default(0)

  dateDebut   DateTime @default(now())
  dateFin     DateTime?
  creeParId   String?

  invitations InvitationReinscription[]

  @@index([tenantId])
  @@index([tenantId, statut])
  @@map("campagne_reinscription")
}

/// Invitation de réinscription envoyée à un parent pour un élève.
///
/// Statuts : INVITE → CONFIRME | REFUSE | SANS_REPONSE
/// Le parent confirme via le portail /parent/reinscription.
model InvitationReinscription {
  id              String   @id @default(cuid())
  tenantId        String

  campagneId      String
  campagne        CampagneReinscription @relation(fields: [campagneId], references: [id], onDelete: Cascade)

  eleveId         String
  eleve           Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  /// INVITE | CONFIRME | REFUSE | SANS_REPONSE
  statut          String   @default("INVITE")

  dateInvitation  DateTime @default(now())
  dateReponse     DateTime?

  /// WHATSAPP | SMS | EMAIL | PORTAIL
  canal           String   @default("WHATSAPP")
  parentPhone     String?
  parentEmail     String?

  /// Nombre de relances envoyées
  nbRelances      Int      @default(0)
  derniereRelance DateTime?

  /// Décision de promotion associée (promouvoir | redoubler | diplome)
  decisionPromotion String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([campagneId])
  @@index([eleveId])
  @@index([tenantId, statut])
  @@map("invitation_reinscription")
}

/// Événement du calendrier scolaire : vacances, examen, jour férié.
///
/// Défini par le chef d'établissement dans Paramètres → Calendrier scolaire.
/// La planification annuelle s'en sert pour ne pas répartir de chapitres
/// sur des semaines sans cours, et pour réserver les semaines d'examen.
model EvenementCalendaire {
  id      String          @id @default(cuid())
  anneeId String
  annee   AnneesScolaires @relation(fields: [anneeId], references: [id], onDelete: Cascade)

  /// VACANCE_SCOLAIRE | EXAMEN | JOUR_FERIE | AUTRE
  type      String
  libelle   String // "Vacances de la Toussaint", "Examen blanc du 1er trimestre"
  dateDebut DateTime
  dateFin   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([anneeId])
  @@index([anneeId, type])
  @@map("evenements_calendaires")
}

/// Événement calendaire OFFICIEL au niveau national (vacances, examens, jours fériés).
///
/// Partagé entre tous les tenants d'un même pays. Les tenants importent ces
/// événements dans leur propre `EvenementCalendaire` (tenant-scoped) au moment
/// de créer leur année scolaire, puis peuvent les compléter avec leurs
/// événements propres (sorties pédagogiques, réunions parents…).
///
/// Ce modèle est géré par les super-administrateurs de la plateforme ou par
/// les ministères via une interface dédiée. Les tenants ne peuvent que
/// consulter et importer, pas modifier.
model CalendrierOfficiel {
  id String @id @default(cuid())

  /// Code ISO pays (ex: "DJ", "SN"). Détermine quels tenants peuvent voir
  /// et importer cet événement.
  country String

  /// Année scolaire concernée (libellé, ex: "2025-2026"). Pas de lien direct
  /// vers AnneesScolaires car les années sont tenant-scoped : on matche par
  /// libelle au moment de l'import.
  anneeLibelle String

  /// VACANCE_SCOLAIRE | EXAMEN | JOUR_FERIE | AUTRE
  type      String
  libelle   String
  dateDebut DateTime
  dateFin   DateTime

  /// Source de l'événement : "ministere", "plateforme", "import".
  /// Pour audit et traçabilité.
  source String @default("ministere")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, anneeLibelle])
  @@index([country, anneeLibelle, type])
  @@map("calendriers_officiels")
}

model Periode {
  id      String          @id @default(cuid())
  anneeId String
  annee   AnneesScolaires @relation(fields: [anneeId], references: [id], onDelete: Cascade)

  nom       String // "Trimestre 1", "Semestre 1"
  numero    Int // 1, 2, 3
  dateDebut DateTime
  dateFin   DateTime
  isCurrent Boolean  @default(false)

  // Clôture / prolongation de période
  statut           String    @default("OUVERTE") // OUVERTE | CLOTUREE
  cloturedAt       DateTime?
  dateLimiteSaisie DateTime? // prolongation exceptionnelle

  notes            Note[]
  bulletins        Bulletin[]
  evaluations      Evaluation[]
  emploisTemps     EmploiTemps[]
  indisponibilites IndisponibiliteEnseignant[]

  @@index([anneeId])
  @@map("periodes")
}

// ============================================================
// UTILISATEURS & AUTHENTIFICATION
// ============================================================

enum Role {
  SUPER_ADMIN // Équipe EcolPro
  TENANT_ADMIN // Directeur/Propriétaire
  PRINCIPAL // Chef d'établissement
  SECRETARY // Secrétariat
  TEACHER // Enseignant
  CLASS_TEACHER // Professeur principal
  COUNSELOR // Conseiller d'orientation / CPE
  NURSE // Infirmier(e)
  ACCOUNTANT // Gestionnaire financier (comptable)
  CAISSIER // Caissier — saisie des recettes, remise de caisse
  SUPERVISOR // Surveillant / Vie scolaire
  SUBJECT_LEAD // Coordinateur de matière
  SITE_MANAGER // Responsable d'exploitation site (salles, équipement, personnel de service)
  INSPECTOR // Inspecteur MENFOP — lecture seule, pas de données nominatives inutiles
  PARENT // Parent / Tuteur légal
  STUDENT // Élève
}

model User {
  id       String  @id @default(cuid())
  tenantId String? // null pour SUPER_ADMIN
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = tous les sites (direction générale)
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  email         String    @unique
  emailVerified DateTime?
  password      String? // hashé avec bcrypt
  name          String
  firstName     String?
  lastName      String?
  avatarUrl     String?
  phone         String?

  role        Role      @default(TEACHER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  // Forçage du changement de mot de passe au prochain login.
  // Mis à true lors de la génération en masse de comptes (élèves/parents)
  // avec un mot de passe initial prévisible (DOB). L'utilisateur ne peut
  // accéder au tableau de bord qu'après l'avoir changé.
  mustChangePassword Boolean @default(false)

  // 2FA / TOTP
  twoFactorEnabled    Boolean   @default(false)
  totpSecret          String? // secret TOTP chiffré (base32)
  totpSecretIv        String? // IV de chiffrement du secret
  backupCodes         String[]  @default([]) // codes de secours hashés
  twoFactorVerifiedAt DateTime? // dernière vérification 2FA réussie

  // Préférences
  langue        String @default("fr")
  locale        String @default("fr") // FR ou EN pour l'interface
  notifications Json? // { email: true, sms: false, push: true }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Relations métier
  enseignants Enseignant[]
  parents     Parent[]
  eleve       Eleve?

  // Messagerie
  messagesSent         Message[]                 @relation("MessageSender")
  conversationsJoined  ConversationParticipant[]
  conversationsCreated Conversation[]            @relation("ConversationCreator")

  // Vie scolaire
  incidentsRapportes Incident[] @relation("IncidentReporter")
  incidentsResolus   Incident[] @relation("IncidentResolver")
  incidentsClasses   Incident[] @relation("IncidentCloser")

  // Notifications envoyées
  notificationsEnvoyees Notification[] @relation("NotificationSender")

  // Appareils mobiles (push)
  devices DeviceToken[] @relation("UserDevices")

  // Gouvernance
  conseilsMembre MembreConseil[]

  // Mentorat
  mentoratsEnTantQueMentor  Mentorat[] @relation("MentoratMentor")
  mentoratsEnTantQueMentore Mentorat[] @relation("MentoratMentore")

  // Multi-tenant: liste des tenants accessibles
  userTenants UserTenant[]

  // Multi-rôle: tous les rôles possédés par utilisateur × tenant
  userRoles UserRole[]

  // Permissions personnalisées (overrides granulaires)
  userPermissions UserPermission[]

  // Multi-site: liste des sites accessibles
  userSites UserSite[]

  // Factures & paiements créés par cet utilisateur
  facturesCrees        Facture[]  @relation("FactureCreePar")
  paiementsEnregistres Paiement[] @relation("PaiementEnregistrePar")

  // Relances envoyées et exclusions décidées/levées
  relancesEnvoyees   Relance[]        @relation("RelanceEnvoyeePar")
  exclusionsDecidees ExclusionEleve[] @relation("ExclusionDecideePar")
  exclusionsLevees   ExclusionEleve[] @relation("ExclusionLeveePar")

  // Réintégrations d'élèves exclus validées par cet utilisateur (vie scolaire)
  sanctionsReintegrees Sanction[] @relation("SanctionReintegreePar")

  // Absences & congés du personnel saisis par cet utilisateur
  absencesPersonnelSaisies AbsencePersonnel[] @relation("AbsencePersonnelSaisiePar")
  congesDemandes           CongePersonnel[]   @relation("CongeDemandePar")
  congesApprouves          CongePersonnel[]   @relation("CongeApprouvePar")

  // LEARNOS : interventions dont cet utilisateur est responsable
  learnosInterventionsResponsable StudentIntervention[] @relation("InterventionResponsible")
  learnosPlansResponsable         PlanProgression[]     @relation("PlanResponsable")

  // Infirmerie : passages saisis par cet utilisateur (infirmier)
  passagesInfirmerieSaisis PassageInfirmerie[] @relation("PassageInfirmier")

  // Remplacements de cours décidés par cet utilisateur (direction)
  remplacementsDecides RemplacementCours[] @relation("RemplacementDecidePar")

  // Entretiens conseiller menés par cet utilisateur
  entretiensConseiller EntretienConseiller[] @relation("EntretienConseiller")

  // Tâches assignées à cet utilisateur
  tachesAssignees Tache[] @relation("TacheAssignee")
  tachesCrees     Tache[] @relation("TacheCreePar")

  // Événements dont cet utilisateur est responsable
  evenementsResponsable Evenement[] @relation("EvenementResponsable")

  // Dépenses enregistrées par cet utilisateur
  depensesEnregistrees Depense[] @relation("DepenseEnregistrePar")

  // Dépenses autorisées par cet utilisateur (engagement)
  depensesAutorisees Depense[] @relation("DepenseAutorisePar")
  // Dépenses payées par cet utilisateur (règlement)
  depensesPayees     Depense[] @relation("DepensePayePar")

  // Remises de caisse : caissier (qui remet) et receveur (qui confirme)
  remisesCaisseCaissier RemiseCaisse[] @relation("RemiseCaisseCaissier")
  remisesCaisseReceveur RemiseCaisse[] @relation("RemiseCaisseReceveur")

  // Commentaires sur les séances pédagogiques (cahier journal)
  seanceCommentaires SeanceCommentaire[] @relation("SeanceCommentaireAuteur")

  // Dossiers d'inscription : création, validation, historique (secrétariat)
  candidaturesCrees     Candidature[]           @relation("CandidatureCreePar")
  candidaturesValidees  Candidature[]           @relation("CandidatureValidePar")
  inscriptionHistorique InscriptionHistorique[] @relation("InscriptionHistoriqueAuteur")

  @@index([tenantId])
  @@index([siteId])
  @@map("users")
}

// ============================================================
// USER TENANT (Jointure multi-tenant — un user peut accéder à plusieurs écoles)
// ============================================================

model UserTenant {
  id        String  @id @default(cuid())
  userId    String
  tenantId  String
  role      Role // Rôle spécifique à ce tenant
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // Tenant par défaut à la connexion

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId]) // Un user = une seule fois par tenant
  @@index([tenantId])
  @@map("user_tenants")
}

// ============================================================
// USER ROLE (Multi-rôle — un user peut posséder plusieurs rôles
// dans le même tenant. UserTenant.role = rôle ACTIF, UserRole =
// inventaire complet des rôles possédés.)
// ============================================================

model UserRole {
  id       String  @id @default(cuid())
  userId   String
  tenantId String
  role     Role // Un rôle possédé (parmi plusieurs possibles)
  isActive Boolean @default(true) // Désactivé sans suppression (soft delete)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId, role]) // Un rôle par user par tenant, mais plusieurs lignes
  @@index([tenantId])
  @@map("user_roles")
}

// ============================================================
// USER PERMISSION — Override granulaire par utilisateur
// ============================================================

model UserPermission {
  id         String @id @default(cuid())
  userId     String
  tenantId   String
  permission String // Format "module:action" (ex: "eleves:write")
  mode       String @default("grant") // "grant" ou "deny"

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId, permission])
  @@index([tenantId])
  @@index([userId])
  @@map("user_permissions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// STRUCTURE PÉDAGOGIQUE
// ============================================================

enum StructureType {
  MATERNELLE
  PRIMAIRE
  COLLEGE
  LYCEE
}

model Structure {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = structure partagée entre tous les sites
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  type  StructureType // MATERNELLE, PRIMAIRE, COLLEGE, LYCEE
  nom   String // "Maternelle", "Primaire", etc.
  actif Boolean       @default(true)

  classes Classe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, siteId, type])
  // Note : un index unique partiel (WHERE "siteId" IS NULL) est créé via migration SQL
  // pour garantir 1 seule structure partagée par type par tenant (PostgreSQL traite NULL comme distinct)
  @@index([tenantId])
  @@index([siteId])
  @@map("structures")
}

model Classe {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  structureId String? // null = non rattaché à une structure pédagogique
  structure   Structure? @relation(fields: [structureId], references: [id], onDelete: SetNull)

  nom         String // "Terminale A", "CM2 A"
  niveau      String // "Terminale", "CM2"
  filiere     String? // "Scientifique", "Littéraire"
  effectifMax Int     @default(40)
  annee       String // "2025-2026"

  profPrincipalId String?
  profPrincipal   Enseignant? @relation("ProfPrincipal", fields: [profPrincipalId], references: [id])

  /// Soft delete — null = classe active, date = classe archivée.
  /// Une classe archivée disparaît des listes actives mais reste restaurable
  /// avec toutes ses données (notes, évaluations, emplois du temps).
  /// Pratique Google Classroom / PowerSchool : archive au lieu de suppression.
  deletedAt     DateTime?
  deletedBy     String?
  deletedReason String?

  eleves                    Eleve[]
  emploiTemps               EmploiTemps[]
  learnosPlanifications     PlanificationChapitre[]
  planificationsCompetences PlanificationCompetence[]
  notes                     Note[]
  evaluations               Evaluation[]
  conversations             Conversation[]            @relation("ConversationClasse")
  devoirs                   Devoir[]
  remplacements             RemplacementCours[]
  historique                HistoriqueClasse[]
  taches                    Tache[]
  seancesPedagogiques       SeancePedagogique[]
  affectations              AffectationEnseignant[]
  listeFourniture           ListeFournitureClasse?

  @@index([tenantId])
  @@index([siteId])
  @@index([structureId])
  @@index([deletedAt])
  @@map("classes")
}

/// Historique des affectations de classe avec dates d'effet.
/// Inspiré de Pronote/EDT : conserve la trace des changements de classe
/// en cours d'année pour préserver le contexte des notes et évaluations.
model HistoriqueClasse {
  id       String  @id @default(cuid())
  tenantId String
  eleveId  String
  eleve    Eleve   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classeId String?
  classe   Classe? @relation(fields: [classeId], references: [id], onDelete: SetNull)

  dateEntree DateTime  @default(now())
  dateSortie DateTime?
  motif      String? // "Inscription", "Transfert", "Promotion", "Redoublement", "Depart"

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([eleveId])
  @@index([classeId])
  @@map("historique_classes")
}

model Matiere {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = matière partagée entre tous les sites
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  nom         String // "Mathématiques"
  code        String // "MATH"
  coefficient Float   @default(1)
  couleur     String? // couleur UI
  niveau      String? // niveau concerné (null = tous)

  notes            Note[]
  emploiTemps      EmploiTemps[]
  bulletinMatieres BulletinMatiere[]
  evaluations      Evaluation[]
  dispenses        DispenseMatiere[]

  learnosChapitres    Chapitre[]
  learnosEvidences    LearningEvidence[]
  learnosSeuils       SeuilsRecommandation[]
  learnosPlans        PlanProgression[]
  learnosFeuilles     FeuilleExercices[]
  devoirs             Devoir[]
  remplacements       RemplacementCours[]
  taches              Tache[]
  seancesPedagogiques SeancePedagogique[]
  affectations        AffectationEnseignant[]
  demandesFournitures DemandeFourniture[]
  itemsFournitures    ListeFournitureItem[]

  @@index([tenantId])
  @@index([siteId])
  @@map("matieres")
}

// ============================================================
// ÉLÈVES
// ============================================================

enum Sexe {
  M
  F
}

enum StatutEleve {
  ACTIF
  REINSCRIT // réinscrit pour l'année suivante
  NON_REINSCRIT // a quitté (refus ou sans réponse après relances)
  TRANSFERE
  DIPLOME
  EXCLU
  ABANDONNE
}

model Eleve {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  matricule     String // auto-généré
  nom           String
  prenom        String
  dateNaissance DateTime
  lieuNaissance String?
  nationalite   String?     @default("SN")
  sexe          Sexe        @default(M)
  photoUrl      String?
  statut        StatutEleve @default(ACTIF)

  classeId String?
  classe   Classe? @relation(fields: [classeId], references: [id])

  // Compte de connexion élève (optionnel — généré en masse depuis Paramètres/Élèves)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Santé
  groupeSanguin   String?
  allergies       String?
  besoinsSpeciaux String?

  // Régime
  regime    String? // "interne", "demi-pensionnaire", "externe"
  transport String? // ligne de transport

  // Contacts d'urgence
  contactUrgenceNom   String?
  contactUrgencePhone String?

  anneeInscription String
  numeroBoursier   String?

  /// Workflow d'inscription formel (Eduka, PowerSchool) :
  /// trace précisément quand un élève est arrivé et parti.
  dateInscription DateTime? // Date réelle d'inscription (vs anneeInscription = année scolaire)
  dateSortie      DateTime? // Date de départ/sortie de l'établissement
  motifSortie     String? // "Transfert", "Déménagement", "Exclusion", "Fin d'études", "Abandon"

  /// Clé d'identité normalisée « nom|prenom|AAAA-MM-JJ » (voir lib/eleve-identity).
  /// Recalculée à chaque écriture, remise à NULL lors de l'archivage pour
  /// libérer la place. NULL n'entre pas dans la contrainte d'unicité PostgreSQL :
  /// les fiches archivées ne bloquent donc pas une réinscription.
  /// Un homonyme légitime (même nom, prénom ET date) reçoit un suffixe « #2 ».
  identiteKey String?

  /// Lot d'import ayant créé cette fiche — permet d'annuler un import entier.
  importBatchId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete — null = actif, date = archivé/supprimé

  parents           EleveParent[]
  absences          Absence[]
  notes             Note[]
  bulletins         Bulletin[]
  factures          Facture[]
  documents         Document[]
  incidents         Incident[]
  parcours          ParcoursScolaire[]
  dispenses         DispenseMatiere[]
  exclusions        ExclusionEleve[]
  progressions      ProgressionEleve[]
  historiqueClasses HistoriqueClasse[]

  learnosEvidences       LearningEvidence[]
  learnosProfils         StudentLearningProfile[]
  learnosInterventions   StudentIntervention[]
  learnosRecommandations Recommandation[]
  learnosPlans           PlanProgression[]
  learnosFeuilles        FeuilleExercices[]
  learnosAlertesParent   AlerteParent[]
  learnosEchangesParent  EchangeParent[]
  learnosPredictions     PredictionDifficulte[]

  passagesInfirmerie   PassageInfirmerie[]
  ficheSanitaire       FicheSanitaire?
  entretiensConseiller EntretienConseiller[]

  // Self-service : demandes de rattachement déposées par des parents
  demandesLien DemandeLienParent[]

  // Campagne de réinscription
  invitationsReinscription InvitationReinscription[]

  @@unique([tenantId, matricule])
  /// Rend le doublon impossible, et non plus seulement détectable. Les fiches
  /// archivées portent `identiteKey = NULL` : PostgreSQL traitant les NULL
  /// comme distincts, elles ne bloquent aucune réinscription.
  @@unique([tenantId, identiteKey])
  @@index([tenantId])
  @@index([classeId])
  @@index([siteId])
  @@index([importBatchId])
  @@map("eleves")
}

// ============================================================
// PARENTS
// ============================================================

enum LienParente {
  PERE
  MERE
  TUTEUR
  AUTRE
}

model Parent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  nom            String
  prenom         String
  email          String?
  phone          String
  phone2         String?
  telegramChatId String?
  profession     String?
  adresse        String?
  photoUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enfants EleveParent[]

  learnosPreferences PreferencesParent?
  learnosAlertes     AlerteParent[]
  learnosEchanges    EchangeParent[]

  // Self-service : demandes de rattachement d'enfant déposées par ce parent
  demandesLien DemandeLienParent[]

  @@index([tenantId])
  @@index([userId])
  @@map("parents")
}

model EleveParent {
  eleveId  String
  eleve    Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  lien      LienParente @default(PERE)
  isGardien Boolean     @default(false) // tuteur légal principal

  @@id([eleveId, parentId])
  @@index([parentId])
  @@map("eleve_parents")
}

// ============================================================
// ENSEIGNANTS
// ============================================================

model Enseignant {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matricule   String?
  specialite  String?
  typeContrat String? // CDI, CDD, Vacation
  dateEntree  DateTime?

  classesPrincipales      Classe[]                    @relation("ProfPrincipal")
  emploiTemps             EmploiTemps[]
  disponibilites          DisponibiliteEnseignant[]
  indisponibilites        IndisponibiliteEnseignant[]
  ficheRH                 FicheRH?
  sites                   EnseignantSite[]
  absencesPersonnel       AbsencePersonnel[]
  conges                  CongePersonnel[]
  devoirs                 Devoir[]
  remplacementsAbsent     RemplacementCours[]         @relation("RemplacementAbsent")
  remplacementsRemplacant RemplacementCours[]         @relation("RemplacementRemplacant")
  seancesPedagogiques     SeancePedagogique[]
  affectations            AffectationEnseignant[]
  demandesFournitures     DemandeFourniture[]

  @@index([tenantId])
  @@index([userId])
  @@map("enseignants")
}

// ============================================================
// AFFECTATIONS ENSEIGNANT → CLASSE → MATIÈRE
// ============================================================

/// Affectation pédagogique d'un enseignant à une classe pour une matière.
/// Source de vérité pour le périmètre d'un enseignant (quelles classes et
/// matières il peut voir/modifier). Indépendante de l'emploi du temps :
/// un enseignant peut être affecté sans avoir de créneau horaire défini.
///
/// Règles métier (côté UI) :
///  - Primaire : une seule classe, sauf pour les matières de langue
///    (français, anglais) qui peuvent être affectées à plusieurs classes.
///  - Collège/Lycée : plusieurs classes possibles.
///  - Le site de l'enseignant est déduit des classes auxquelles il est
///    affecté.
model AffectationEnseignant {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([enseignantId, classeId, matiereId])
  @@index([tenantId])
  @@index([enseignantId])
  @@index([classeId])
  @@index([matiereId])
  @@map("affectations_enseignants")
}

// ============================================================
// EMPLOI DU TEMPS
// ============================================================

enum Jour {
  DIMANCHE
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
}

model EmploiTemps {
  id       String @id @default(cuid())
  tenantId String

  classeId     String
  classe       Classe      @relation(fields: [classeId], references: [id], onDelete: Cascade)
  matiereId    String
  matiere      Matiere     @relation(fields: [matiereId], references: [id])
  enseignantId String?
  enseignant   Enseignant? @relation(fields: [enseignantId], references: [id])

  /// Période (trimestre/semestre) ciblée par ce créneau. null = emploi du
  /// temps commun à toute l'année. Quand periodeId est renseigné, le créneau
  /// ne s'affiche que pour cette période — permet des EDT différents par
  /// trimestre (ex: prof partiel disponible au T1 mais pas au T2).
  periodeId String?
  periode   Periode? @relation(fields: [periodeId], references: [id], onDelete: SetNull)

  jour       Jour
  heureDebut String // "08:00"
  heureFin   String // "09:00"
  salle      String?
  annee      String

  remplacements RemplacementCours[]

  @@index([tenantId])
  @@index([classeId])
  @@index([matiereId])
  @@index([enseignantId])
  @@map("emplois_temps")
}

model DisponibiliteEnseignant {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId       String? // null = disponibilité sur tous les sites
  site         Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  jour         Jour
  heureDebut   String // "08:00"
  heureFin     String // "12:00"

  @@index([tenantId])
  @@index([siteId])
  @@index([enseignantId])
  @@map("disponibilites_enseignants")
}

/// Indisponibilité d'un enseignant — créneau où il NE PEUT PAS enseigner
/// dans cet établissement. Contrairement à DisponibiliteEnseignant (liste
/// blanche opt-in), ce modèle enregistre explicitement les occupations
/// externes (cours dans un autre établissement, formation, contrainte
/// personnelle) avec leur source pour audit.
///
/// Le moteur d'emploi du temps vérifie les deux :
///   - DisponibiliteEnseignant : le prof DOIT avoir une dispo couvrant le créneau
///     (sauf si aucune dispo n'est enregistrée → libre par défaut)
///   - IndisponibiliteEnseignant : le prof NE DOIT PAS avoir d'indispo
///     chevauchant le créneau
model IndisponibiliteEnseignant {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId       String? // null = indisponibilité sur tous les sites
  site         Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  jour       Jour
  heureDebut String // "08:00"
  heureFin   String // "12:00"

  /// Source de l'indisponibilité pour audit :
  ///   "IMPORT_EXTERNE"  — importé depuis l'EDT d'un autre établissement
  ///   "SAISIE_MANUELLE" — saisi par un admin/conseiller
  ///   "CONGE"           — congé validé (lié à CongePersonnel)
  ///   "FORMATION"       — en formation
  source String @default("SAISIE_MANUELLE")

  /// Nom de l'établissement externe ou libellé libre de la contrainte.
  /// Ex: "École B", "Formation Pédagogique", "Rendez-vous médical".
  sourceLibelle String?

  /// Période concernée (null = toute l'année). Permet de modéliser un prof
  /// partiel disponible au T1 mais occupé ailleurs au T2.
  periodeId String?
  periode   Periode? @relation(fields: [periodeId], references: [id], onDelete: SetNull)

  /// Année scolaire (libellé, ex: "2025-2026") pour filtrer par année.
  anneeLibelle String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([siteId])
  @@index([enseignantId])
  @@index([periodeId])
  @@map("indisponibilites_enseignants")
}

model Salle {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  nom      String // "Salle 101"
  capacite Int     @default(30)
  type     String? // "cours", "labo", "informatique"
  batiment String?

  @@index([tenantId])
  @@index([siteId])
  @@map("salles")
}

// ============================================================
// ABSENCES
// ============================================================

enum MotifAbsence {
  INJUSTIFIE
  MALADIE
  FAMILIALE
  TRANSPORT
  AUTRE
}

enum StatutAbsence {
  EN_ATTENTE
  JUSTIFIEE
  INJUSTIFIEE
}

model Absence {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  date       DateTime
  heureDebut String? // null = journée entière
  heureFin   String?
  isRetard   Boolean  @default(false)

  motif        MotifAbsence  @default(INJUSTIFIE)
  statut       StatutAbsence @default(EN_ATTENTE)
  justificatif String? // URL document
  commentaire  String?

  saisieParId String? // userId enseignant

  // Notification parents
  parentNotifie   Boolean   @default(false)
  parentNotifieAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@index([tenantId, date])
  @@map("absences")
}

// ============================================================
// INFIRMERIE & SANTÉ
// ============================================================

model PassageInfirmerie {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  date        DateTime
  motif       String // maux de tête, blessure, malaise…
  soin        String? // description du soin dispensé
  suite       String // "retour_en_cours", "renvoi_domicile", "hospitalisation"
  retourCours Boolean  @default(true)
  dureeMin    Int?
  infirmierId String?
  infirmier   User?    @relation("PassageInfirmier", fields: [infirmierId], references: [id], onDelete: SetNull)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@index([siteId])
  @@map("passages_infirmerie")
}

model FicheSanitaire {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  eleveId String @unique
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  allergies              String[] // liste d'allergies connues
  traitements            Json? // traitements en cours (médicament, posologie, durée)
  contreIndicationsSport Boolean  @default(false)
  contactsUrgence        Json? // [{ nom, relation, telephone }]
  protocoleUrgence       String? // protocole spécifique (asthme, diabète, épilepsie)
  vaccinations           Json? // [{ vaccin, date, rappel }]
  remarques              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@map("fiches_sanitaires")
}

// ============================================================
// NOTES & ÉVALUATIONS
// ============================================================

enum TypeNote {
  CONTROLE
  DEVOIR
  EXAMEN
  INTERROGATION
  PROJET
  ORAL
  TP
}

model Evaluation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  titre String // "Controle 1 math test"
  type  TypeNote @default(CONTROLE)

  classeId  String
  classe    Classe  @relation(fields: [classeId], references: [id])
  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id])
  periodeId String
  periode   Periode @relation(fields: [periodeId], references: [id])

  date        DateTime
  duree       Int // en minutes
  coefficient Float    @default(1)
  description String?
  statut      String   @default("PLANIFIE") // PLANIFIE, TERMINE

  notes              Note[]
  learnosEvidences   LearningEvidence[]
  learnosCompetences EvaluationCompetence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([classeId])
  @@index([matiereId])
  @@index([periodeId])
  @@index([tenantId, date, statut])
  @@map("evaluations")
}

model Note {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId   String
  eleve     Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classeId  String
  classe    Classe   @relation(fields: [classeId], references: [id])
  matiereId String
  matiere   Matiere  @relation(fields: [matiereId], references: [id])
  periodeId String?
  periode   Periode? @relation(fields: [periodeId], references: [id])

  type        TypeNote @default(CONTROLE)
  intitule    String? // "DS n°1", "Examen semestriel"
  valeur      Float
  noteMax     Float    @default(20)
  coefficient Float    @default(1)
  date        DateTime

  appreciation String?
  commentaire  String? // Commentaire spécifique de l'évaluation
  saisieParId  String? // userId enseignant
  isPubliee    Boolean @default(false)

  evaluationId String?
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  learnosEvidences LearningEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@index([classeId])
  @@index([matiereId])
  @@index([periodeId])
  @@index([evaluationId])
  @@map("notes")
}

// ============================================================
// BULLETINS
// ============================================================

model Bulletin {
  id       String @id @default(cuid())
  tenantId String

  eleveId   String
  eleve     Eleve   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  periodeId String
  periode   Periode @relation(fields: [periodeId], references: [id])

  moyenneGenerale Float?
  moyenneClasse   Float?
  moyennePremier  Float?
  heuresAbsence   Int?   @default(0)

  rang           Int?
  effectifClasse Int?
  appreciation   String?
  decision       String? // "Passage", "Redoublement", "Félicitations"

  /// BROUILLON (généré, modifiable) | VERROUILLE (clôturé, seul admin peut modifier) | PUBLIE (publié aux parents, verrouillé)
  statut          String    @default("BROUILLON")
  isPublie        Boolean   @default(false)
  publishedAt     DateTime?
  verrouilleAt    DateTime?
  verrouilleParId String?
  pdfUrl          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matieres   BulletinMatiere[]
  historique BulletinHistorique[]

  @@unique([eleveId, periodeId])
  @@index([tenantId])
  @@index([periodeId])
  @@index([tenantId, isPublie])
  @@index([tenantId, statut])
  @@map("bulletins")
}

/// Journal d'audit des modifications de bulletin.
/// Chaque modification (même par le directeur) est enregistrée ici,
/// avec l'ancienne et la nouvelle valeur du champ modifié.
model BulletinHistorique {
  id       String @id @default(cuid())
  tenantId String

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  /// ID de l'utilisateur qui a fait la modification
  auteurId   String?
  /// Nom affichable de l'utilisateur (dénormalisé pour l'audit)
  auteurNom  String?
  /// Rôle de l'utilisateur au moment de la modification
  auteurRole String?

  /// Champ modifié : "moyenneGenerale", "appreciation", "decision", "rang", "statut", "DELETE", etc.
  champ          String
  /// Valeur avant modification (sérialisée en JSON)
  ancienneValeur String?
  /// Valeur après modification (sérialisée en JSON)
  nouvelleValeur String?

  /// Action : "UPDATE", "DELETE", "PUBLIER", "VERROUILLER", "DEVERROUILLER", "GENERER"
  action String

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([bulletinId])
  @@index([auteurId])
  @@index([createdAt])
  @@map("bulletin_historique")
}

model BulletinMatiere {
  id       String @id @default(cuid())
  tenantId String

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  matiereId String
  matiere   Matiere @relation(fields: [matiereId], references: [id])

  nomProfesseur String?

  coefficient  Float
  moyenneEleve Float?
  rang         Int?
  moyenneMax   Float?
  moyenneMin   Float?

  appreciation String?

  @@index([tenantId])
  @@index([bulletinId])
  @@index([matiereId])
  @@map("bulletin_matieres")
}

// ============================================================
// EXAMENS
// ============================================================

enum StatutExamen {
  PROGRAMME
  EN_COURS
  TERMINE
  ANNULE
}

model Examen {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  intitule    String // "Baccalauréat 2026"
  description String?
  statut      StatutExamen @default(PROGRAMME)
  dateDebut   DateTime
  dateFin     DateTime

  /// Lien optionnel avec une feuille d'exercices LEARNOS.
  /// Permet de transformer un examen en feuille d'évaluation
  /// pédagogique avec exercices assignés et auto-correction.
  feuilleExercicesId String?
  feuilleExercices   FeuilleExercices? @relation(fields: [feuilleExercicesId], references: [id], onDelete: SetNull)

  sessions SessionExamen[]

  @@index([tenantId])
  @@index([siteId])
  @@map("examens")
}

model SessionExamen {
  id     String @id @default(cuid())
  examId String
  examen Examen @relation(fields: [examId], references: [id], onDelete: Cascade)

  matiereNom   String
  date         DateTime
  heureDebut   String
  heureFin     String
  salle        String?
  surveillants Json? // array of user IDs
  niveau       String?

  @@index([examId])
  @@map("sessions_examen")
}

// ============================================================
// FACTURATION
// ============================================================

enum StatutFacture {
  EN_ATTENTE
  PAYEE
  EN_RETARD
  ANNULEE
}

model Facture {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = non rattaché à un site spécifique
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// Nullable pour les factures d'admission créées AVANT l'élève (passage à ADMIS).
  /// Rattaché rétroactivement quand l'élève est créé (passage à INSCRIT).
  eleveId String?
  eleve   Eleve?  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  /// Lien vers la candidature d'admission (facture générée au passage à ADMIS).
  /// Null pour les factures de scolarité classiques.
  candidatureId String?
  candidature   Candidature? @relation(fields: [candidatureId], references: [id], onDelete: SetNull)

  /// Année scolaire de rattachement. Nullable pour les factures créées
  /// avant l'ajout du champ — backfillées par migration de données.
  anneeId String?
  annee   AnneesScolaires? @relation(fields: [anneeId], references: [id], onDelete: SetNull)

  numero   String
  libelle  String // "Scolarité 2025-2026", "Cantine Octobre"
  montant  Float
  devise   String        @default("DJF")
  statut   StatutFacture @default(EN_ATTENTE)
  echeance DateTime?

  /// Mois de scolarité facturé (format "YYYY-MM"). Null pour les factures
  /// qui ne sont pas liées à un mois spécifique (frais d'inscription, etc.).
  mois String?

  paiements  Paiement[]
  relances   Relance[]
  echeances  EcheancePaiement[]
  echeancier Echeancier?

  createdById String? // User who created the invoice
  createdBy   User?   @relation("FactureCreePar", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@index([candidatureId])
  @@index([tenantId, statut])
  @@index([siteId])
  @@index([anneeId])
  @@index([tenantId, anneeId])
  @@map("factures")
}

// ============================================================
// ÉCHÉANCIER DE PAIEMENT (paiements échelonnés)
// ============================================================

/// Plan de paiement échelonné pour une facture.
/// Permet de découper une facture en plusieurs échéances avec dates
/// d'échéance et montants prédéfinis, plutôt qu'un seul champ `echeance`.
model Echeancier {
  id        String  @id @default(cuid())
  factureId String  @unique
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  /// Nombre total d'échéances prévues
  nbEcheances Int

  /// Intervalle en jours entre deux échéances (0 = dates libres)
  intervalleJours Int @default(30)

  /// Date de la première échéance
  datePremiereEcheance DateTime

  /// Statut du plan : ACTIF | COMPLETE | ANNULE
  statut String @default("ACTIF")

  echeances EcheancePaiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factureId])
  @@map("echeanciers")
}

/// Une échéance individuelle d'un plan de paiement.
model EcheancePaiement {
  id           String     @id @default(cuid())
  echeancierId String
  echeancier   Echeancier @relation(fields: [echeancierId], references: [id], onDelete: Cascade)
  factureId    String
  facture      Facture    @relation(fields: [factureId], references: [id], onDelete: Cascade)

  numero       Int // 1, 2, 3...
  montant      Float
  devise       String   @default("DJF")
  dateEcheance DateTime

  /// EN_ATTENTE | PAYEE | EN_RETARD | ANNULEE
  statut String @default("EN_ATTENTE")

  /// Lien vers le paiement qui a réglé cette échéance (nullable, 1:1)
  paiementId String?   @unique
  paiement   Paiement? @relation(fields: [paiementId], references: [id], onDelete: SetNull)

  payeeLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([echeancierId, numero])
  @@index([echeancierId])
  @@index([factureId])
  @@index([dateEcheance])
  @@map("echeances_paiement")
}

model Paiement {
  id        String  @id @default(cuid())
  factureId String
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  montant    Float
  devise     String   @default("DJF")
  methode    String // "espèces", "waffi", "cac_pay", "dahab_plus", "saba_pay", "faida", "virement"
  reference  String?
  date       DateTime @default(now())
  /// Date de saisie — automatiquement le jour de la saisie.
  /// Doit être identique à la date figurant sur le reçu de paiement.
  dateSaisie DateTime @default(now())
  recu       String? // URL reçu PDF

  enregistreParId String? // User who recorded the payment
  enregistrePar   User?   @relation("PaiementEnregistrePar", fields: [enregistreParId], references: [id], onDelete: SetNull)

  echeancePaiement EcheancePaiement? // si ce paiement règle une échéance spécifique

  @@index([factureId])
  @@map("paiements")
}

// ============================================================
// TARIFICATION PAR NIVEAU
// ============================================================

model TarifNiveau {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

