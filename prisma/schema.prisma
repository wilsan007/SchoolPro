// ============================================================
// VIE SCOLAIRE & DISCIPLINE
// ============================================================

enum TypeIncident {
  RETARD
  BAVARDAGE
  INSOLENCE
  BAGARRE
  TRICHE
  VANDALISM
  ABSENTEISME
  AUTRE
}

enum StatutIncident {
  OUVERT
  EN_TRAITEMENT
  RESOLU
  CLASSE
}

enum TypeSanction {
  AVERTISSEMENT
  BLAME
  EXCLUSION_COURS
  EXCLUSION_TEMP
  CONVOCATION_PARENTS
  TRAVAUX_INTERET_GENERAL
  AUTRE
}

model Incident {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  rapporteParId String?
  rapportePar   User?   @relation("IncidentReporter", fields: [rapporteParId], references: [id])

  type        TypeIncident   @default(AUTRE)
  statut      StatutIncident @default(OUVERT)
  gravite     Int            @default(1) // 1=léger, 2=moyen, 3=grave
  description String
  lieu        String?
  date        DateTime

  sanctions Sanction[]

  notes String? // notes internes

  // --- Traçabilité de la résolution / classement ---
  // Description concrète de la mesure prise pour résoudre l'incident.
  // Obligatoire lors du passage à RESOLU (validé côté API + UI).
  actionPrise     String?
  // Qui a résolu l'incident et quand.
  resoluParId     String?
  resoluPar       User?     @relation("IncidentResolver", fields: [resoluParId], references: [id])
  dateResolution  DateTime?
  // Classement sans suite : qui, quand et pourquoi.
  classeParId     String?
  classePar       User?     @relation("IncidentCloser", fields: [classeParId], references: [id])
  dateClassement  DateTime?
  motifClassement String? // raison du classement sans suite (obligatoire si CLASSE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([eleveId])
  @@index([tenantId, statut, date])
  @@map("incidents")
}

model Sanction {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  type          TypeSanction
  description   String?
  dateDebut     DateTime
  dateFin       DateTime?
  parentNotifie Boolean      @default(false)

  // --- Cycle de vie des exclusions (EXCLUSION_COURS / EXCLUSION_TEMP) ---
  // Une exclusion n'est pas qu'une décision : elle s'exécute, doit préserver la
  // continuité pédagogique, et se termine par une réintégration tracée.

  /// Date de retour réellement constatée. NULL tant que l'élève n'est pas réintégré.
  /// Peut différer de dateFin (retour anticipé ou tardif).
  dateRetourEffective DateTime?

  /// Qui a validé la réintégration (CPE, principal). NULL = pas encore réintégré.
  reintegreParId String?
  reintegrePar   User?   @relation("SanctionReintegreePar", fields: [reintegreParId], references: [id], onDelete: SetNull)

  /// Continuité pédagogique : travail donné à l'élève pendant l'exclusion.
  /// Obligatoire en pratique pour toute exclusion temporaire.
  travailDonne String?

  /// Horodatage de l'accusé de réception du parent. NULL = pas encore accusé.
  /// `parentNotifie` dit qu'on a envoyé ; ce champ dit que la famille a confirmé.
  accuseReceptionParent DateTime?

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@index([type, dateRetourEffective])
  @@map("sanctions")
}

