// ============================================================
// ADMISSIONS & INSCRIPTIONS
// ============================================================

enum StatutCandidature {
  SOUMISE // Candidature reçue, en attente de traitement
  DOSSIER_COMPLET // Toutes les pièces justificatives ont été fournies
  EN_EXAMEN // Dossier en cours d'examen
  ADMIS // Candidat admis
  REFUSE // Candidature refusée
  INSCRIT // Passage en inscription confirmée
  ANNULE // Candidature annulée
}

// Statut du dossier d'inscription (constitution des pièces + validation).
// Indépendant du workflow d'admission (StatutCandidature) : un dossier peut
// être INCOMPLET même si la candidature est ADMIS, et devient VALIDE/CLOS
// une fois toutes les pièces fournies et validées par la direction.
enum StatutDossier {
  INCOMPLET // Dossier manquant de pièces obligatoires
  EN_COURS // Dossier en cours de constitution
  COMPLETE // Toutes les pièces obligatoires fournies
  VALIDE // Validé par la direction
  CLOS // Dossier clôturé (élève inscrit ou refusé définitif)
}

// Types de documents requis pour une inscription complète.
enum TypeDocumentInscription {
  PHOTO // Photo de l'élève
  ACTE_NAISSANCE // Acte / certificat de naissance
  PIECE_PARENT // Pièce d'identité des parents
  BULLETIN_SCOLAIRE // Bulletin / relevé de notes scolaire
}

// Événements tracés dans l'historique d'un dossier d'inscription.
enum TypeEvenementInscription {
  CREATION_DOSSIER // Dossier créé
  AJOUT_DOCUMENT // Une pièce a été ajoutée
  SUPPRESSION_DOCUMENT // Une pièce a été retirée
  CHANGEMENT_STATUT // Le statut du dossier a changé
  COMPLETION_DOSSIER // Dossier passé à COMPLETE
  VALIDATION_DOSSIER // Dossier validé par la direction
  CLOTURE_DOSSIER // Dossier clôturé
  MODIFICATION_INFOS // Informations élève/parent modifiées
  NOTE_AJOUTEE // Note interne ajoutée
}

model Candidature {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = candidature non rattachée à un site
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Informations élève
  nom           String
  prenom        String
  dateNaissance DateTime
  lieuNaissance String?
  sexe          Sexe     @default(M)
  nationalite   String?  @default("SN")
  photoUrl      String?

  // Scolarité souhaitée
  classeVoulue String // "6ème", "Terminale S"
  annee        String // "2026-2027"

  // Contacts parents
  parentNom    String
  parentPrenom String
  parentEmail  String?
  parentPhone  String
  parentLien   LienParente @default(PERE)

  // Statut & workflow
  statut      StatutCandidature @default(SOUMISE)
  dateExamen  DateTime? // date de l'examen d'entrée
  noteExamen  Float? // note obtenue à l'examen
  commentaire String? // notes internes admin
  motifRefus  String?

  // Documents joints (URLs) — historique générique (candidature publique)
  documents Json? // [{ nom: "Bulletin", url: "..." }]

  // ── Dossier d'inscription formel (côté secrétariat) ──────────────
  // Pièces structurées requises : photo, acte de naissance, pièce parent,
  // bulletin scolaire. Chaque entrée : { url, nom, taille, ajouteLe, ajouteParId }
  documentsInscription Json?

  // Statut du dossier d'inscription (constitution + validation)
  dossierStatut StatutDossier @default(INCOMPLET)

  // Traçabilité : qui a créé / validé / clôturé le dossier
  creeParId   String?
  creePar     User?     @relation("CandidatureCreePar", fields: [creeParId], references: [id], onDelete: SetNull)
  valideParId String?
  validePar   User?     @relation("CandidatureValidePar", fields: [valideParId], references: [id], onDelete: SetNull)
  valideLe    DateTime?
  closLe      DateTime?

  // Historique d'audit du dossier (création, ajouts, changements de statut…)
  historique InscriptionHistorique[]

  // Factures liées à cette candidature (générée au passage à ADMIS)
  factures Facture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, statut])
  @@index([tenantId, dossierStatut])
  @@index([siteId])
  @@map("candidatures")
}

