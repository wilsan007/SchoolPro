  REALISE
  ANNULE
  REPORTÉ
}

// ============================================================
// DEMANDE DE LIEN PARENT ↔ ÉLÈVE (self-service)
// Un parent connecté demande à rattacher un autre enfant à son
// compte en saisissant matricule + date de naissance. L'admin
// valide avant que le lien EleveParent ne soit créé.
// ============================================================

enum StatutDemandeLien {
  EN_ATTENTE
  VALIDE
  REFUSE
}

model DemandeLienParent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parentId String // Parent qui demande (a déjà un compte)
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  eleveId String // Élève à rattacher
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  // Données saisies par le parent pour prouver le lien
  matriculeSaisi      String
  dateNaissanceSaisie DateTime

  statut StatutDemandeLien @default(EN_ATTENTE)

  // Traitement admin
  traitePar  String? // userId de l'admin
  traiteLe   DateTime?
  motifRefus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, eleveId]) // Une seule demande par couple parent↔élève
  @@index([tenantId])
  @@index([statut])
  @@map("demandes_lien_parent")
}

// ============================================================
// LEARNOS — Plans de leçon & grilles d'évaluation (IA générative)
// ============================================================

/// Statut du workflow de validation pour les propositions IA.
///
///   PROPOSE → l'IA a généré, en attente de relecture enseignant
///   AJUSTE  → l'enseignant a modifié, en attente de validation direction
///   VALIDE  → le directeur/principal/tenant-admin a validé
///   REJETE  → rejeté à quelque étape que ce soit
enum StatutPropositionIa {
  PROPOSE
  AJUSTE
  VALIDE
  REJETE
}

/// Plan de leçon proposé par l'IA, puis ajusté par l'enseignant,
/// puis validé par la direction.
///
/// Workflow :
///   1. L'IA génère → statut PROPOSE
///   2. L'enseignant révise/ajuste → statut AJUSTE
///   3. Le directeur/principal/tenant-admin valide → statut VALIDE
///   4. N'importe quelle étape peut rejeter → statut REJETE
model PlanLecon {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId   String?
  site     Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  competenceId String
  competence   Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  /// Niveau scolaire visé (ex: "CM2", "Terminale").
  niveauScolaire String
  /// Durée totale en minutes.
  dureeTotale    Int

  /// Titre du plan de leçon.
  titre           String
  /// Objectifs d'apprentissage (JSON array de strings).
  objectifs       String
  /// Étapes structurées (JSON array : { nom, duree, description, support? }).
  etapes          String
  /// Matériel nécessaire (JSON array de strings).
  materiel        String?
  /// Méthode d'évaluation finale.
  evaluation      String?
  /// Adaptation pour élèves en difficulté / en avancement.
  differentiation String?

  /// Workflow de validation.
  statut StatutPropositionIa @default(PROPOSE)

  /// Enseignant qui a proposé/ajusté.
  proposeParId String?
  ajusteParId  String?
  ajusteLe     DateTime?

  /// Direction qui a validé/rejeté.
  valideParId String?
  valideLe    DateTime?
  motifRejet  String?

  /// Modèle IA qui a généré (pour traçabilité).
  modeleIa String?
  cachedIa Boolean @default(false)

  /// Séances pédagogiques qui utilisent ce plan de leçon.
  seances SeancePedagogique[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([competenceId])
  @@index([statut])
  @@map("learnos_plans_lecon")
}

/// Grille d'évaluation (rubric) proposée par l'IA, puis validée.
///
/// Même workflow que PlanLecon :
///   PROPOSE → AJUSTE → VALIDE / REJETE
model RubriqueEvaluation {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId   String?
  site     Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  competenceId String
  competence   Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  /// Niveau scolaire visé.
  niveauScolaire String
  /// Barème total (ex: 20).
  totalPoints    Int

  /// Titre de la grille.
  titre    String
  /// Critères structurés (JSON : { nom, points, niveaux: { excellent, satisfaisant, fragile, insuffisant } }[]).
  criteres String

  /// Workflow de validation.
  statut StatutPropositionIa @default(PROPOSE)

  proposeParId String?
  ajusteParId  String?
  ajusteLe     DateTime?
  valideParId  String?
  valideLe     DateTime?
  motifRejet   String?

  modeleIa String?
  cachedIa Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([competenceId])
  @@index([statut])
  @@map("learnos_rubriques_evaluation")
}

// ============================================================
// BUDGET & DÉPENSES (comptabilité d'exploitation par site)
// ============================================================

enum CategorieBudget {
  FONCTIONNEMENT // eau, électricité, fournitures, entretien
  PEDAGOGIE // manuels, matériel didactique, logiciels
  MAINTENANCE // bâtiments, équipements, réparations
  SALAIRES // rémunérations enseignants & personnel
  TRANSPORT // bus scolaires, carburant
  CANTINE // fonctionnement de la cantine
  EVENEMENTIEL // sorties, cérémonies, examens
  INVESTISSEMENT // équipements lourds, travaux
  AUTRE
}

model Budget {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = budget global (tous sites)
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  annee          String // "2024-2025"
  categorie      CategorieBudget
  montantPrevu   Float // budget alloué
  montantDepense Float           @default(0) // total dépensé (calculé)
  devise         String          @default("DJF")

  /// "PROPOSE" | "VALIDE" | "CLOTURE" | "DEPASSE"
  statut String @default("VALIDE")

  description String?

  depenses Depense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, siteId, annee, categorie])
  @@index([tenantId])
  @@index([siteId])
  @@map("budgets")
}

model Depense {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = dépense globale
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  budgetId String? // null = dépense hors budget
  budget   Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  date      DateTime
  montant   Float
  devise    String          @default("DJF")
  categorie CategorieBudget @default(AUTRE)

  libelle     String
  description String?

  /// Mode de paiement
  methodePaiement String? // "especes", "cheque", "virement", "mobile_money"
  reference       String? // numéro de pièce, reçu
  justificatifUrl String? // URL du justificatif scanné

  // ── Traçabilité de l'engagement de dépense ──
  /// Personne qui a autorisé l'engagement de cette dépense
  autoriseParId String?
  autorisePar   User?   @relation("DepenseAutorisePar", fields: [autoriseParId], references: [id], onDelete: SetNull)

  /// Personne qui a effectué le paiement (peut différer de l'autorisation)
  payeParId String?
  payePar   User?   @relation("DepensePayePar", fields: [payeParId], references: [id], onDelete: SetNull)

  /// Type d'engagement auprès du fournisseur
  /// "bon_commande" | "facture_fournisseur" | "achat_direct" | "contrat" | "autre"
  typeEngagement String?

  /// Nom du fournisseur / prestataire
  fournisseur        String?
  /// Contact du fournisseur (téléphone, email, adresse — texte libre)
  fournisseurContact String?

  /// Utilisateur qui a enregistré la dépense
  enregistreParId String?
  enregistrePar   User?   @relation("DepenseEnregistrePar", fields: [enregistreParId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([budgetId])
  @@index([date])
  @@map("depenses")
}

// ============================================================
// REMISE DE CAISSE (remise des recettes journalières)
// ============================================================

/// Statut d'une remise de caisse :
/// EN_ATTENTE — le caissier a déclaré la remise, en attente de confirmation du receveur
/// CONFIRME   — le receveur a confirmé avoir reçu (montants/dates/noms identiques)
/// REJETE     — le receveur a refusé (écart entre déclaration et réception)
enum StatutRemiseCaisse {
  EN_ATTENTE
  CONFIRME
  REJETE
}

/// Remise des recettes de la journée par le caissier à un receveur
/// (comptable ou directeur). La remise n'est considérée comme validée
/// que lorsque le receveur confirme avoir reçu le même montant, à la
/// même date, de la part du même caissier.
model RemiseCaisse {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String? // null = remise globale (tous sites)
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // ── Côté caissier (déclaration) ──
  /// Caissier qui remet les recettes
  caissierId String
  caissier   User   @relation("RemiseCaisseCaissier", fields: [caissierId], references: [id], onDelete: Cascade)

  /// Montant déclaré par le caissier
  montantDeclare   Float
  /// Date à laquelle le caissier déclare avoir remis la caisse
  dateRemise       DateTime
  /// Date de saisie de la déclaration (automatique — jour de la saisie)
  dateSaisieRemise DateTime @default(now())

  // ── Côté receveur (confirmation) ──
  /// Receveur désigné (comptable ou directeur) — null jusqu'à confirmation
  receveurId String?
  receveur   User?   @relation("RemiseCaisseReceveur", fields: [receveurId], references: [id], onDelete: SetNull)

  /// Montant confirmé par le receveur (doit être identique à montantDeclare)
  montantRecu         Float?
  /// Date à laquelle le receveur confirme avoir reçu (automatique)
  dateReception       DateTime?
  /// Date de saisie de la confirmation (automatique — jour de la saisie)
  dateSaisieReception DateTime?

  /// Commentaire du receveur (motif de rejet, observations)
  commentaireReceveur String?

  statut StatutRemiseCaisse @default(EN_ATTENTE)

  /// Période couverte par la remise (date de début et fin des recettes)
  periodeDebut DateTime
  periodeFin   DateTime

  /// Devise des montants
  devise String @default("DJF")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([caissierId])
  @@index([receveurId])
  @@index([statut])
  @@index([dateRemise])
  @@map("remises_caisse")
}

// ============================================================
// TÂCHES DU PERSONNEL (suivi d'activité enseignants & staff)
// ============================================================

enum PrioriteTache {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  FAIT
  ANNULE
}

model Tache {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// Utilisateur à qui la tâche est assignée
  assigneeAId String
  assigneeA   User   @relation("TacheAssignee", fields: [assigneeAId], references: [id], onDelete: Cascade)

  /// Utilisateur qui a créé la tâche (direction, chef d'établissement)
  creeParId String?
  creePar   User?   @relation("TacheCreePar", fields: [creeParId], references: [id], onDelete: SetNull)

  titre       String
  description String?

  /// Type de tâche : "saisie_notes", "conseil_classe", "rendez_vous_parent",
  /// "preparation_cours", "correction_devoirs", "remise_bulletins",
  /// "reunion_pedagogique", "sortie_pedagogique", "inventaire", "autre"
  type     String        @default("autre")
  priorite PrioriteTache @default(NORMALE)
  statut   StatutTache   @default(A_FAIRE)

  /// Lien optionnel avec une classe (ex: préparation cours pour une classe)
  classeId String?
  classe   Classe? @relation(fields: [classeId], references: [id], onDelete: SetNull)

  /// Lien optionnel avec une matière
  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  echeance  DateTime?
  dateFaite DateTime?

  /// Source auto-générée : type de la source (ex: "evaluation_sans_notes",
  /// "seance_a_valider", "devoir_a_corriger", "bulletin_a_publier",
  /// "incident_a_traiter", "absence_a_justifier", "facture_en_retard",
  /// "reinscription_en_attente", "evaluation_a_venir").
  /// NULL pour les tâches créées manuellement.
  sourceType String?

  /// ID de l'enregistrement source (ex: ID de l'évaluation, du bulletin…).
  /// Permet l'idempotence : le moteur ne recrée pas une tâche pour un
  /// enregistrement qui en a déjà une non terminée.
  sourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([assigneeAId])
  @@index([statut])
  @@index([sourceType, sourceId])
  @@map("taches")
}

// ============================================================
// FOURNITURES & LIVRES SCOLAIRES
// ============================================================

/// Type de fourniture demandée par un enseignant.
enum TypeFourniture {
  LIVRE
  CAHIER
  INSTRUMENT
  AUTRE
}

/// Statut d'une demande de fourniture faite par un enseignant.
/// PROPOSEE → VALIDEE (secrétariat) ou REJETEE
enum StatutDemandeFourniture {
  PROPOSEE
  VALIDEE
  REJETEE
}

/// Statut d'une liste de fournitures publiée pour une classe.
/// BROUILLON → PUBLIEE (secrétariat)
enum StatutListeFourniture {
  BROUILLON
  PUBLIEE
}

/// Demande d'un enseignant pour des fournitures par niveau de classe.
/// L'enseignant saisit une seule fois par niveau (ex: "6ème"),
/// pas par classe individuelle — la propagation se fait au moment
/// de la publication par le secrétariat.
model DemandeFourniture {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// Enseignant qui a fait la demande
  enseignantId String
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)

  /// Niveau de classe (ex: "6ème", "Terminale") — pas de classeId
  niveau String

  /// Matière concernée (null = fourniture générale pour toutes les matières)
  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  type        TypeFourniture
  nom         String
  description String?
  quantite    Int            @default(1)
  format      String? // "A4", "17x22", "Grand carreaux"
  prixEstime  Float? // prix indicatif

  statut                StatutDemandeFourniture @default(PROPOSEE)
  valideeParId          String?
  valideeLe             DateTime?
  commentaireValidation String? // note du secrétariat

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([siteId])
  @@index([enseignantId])
  @@index([niveau])
  @@index([matiereId])
  @@index([statut])
  @@map("demandes_fournitures")
}

/// Liste de fournitures publiée pour une classe spécifique.
/// Créée par le secrétariat en compilant les DemandesFourniture validées
/// pour un niveau donné, puis propagée à toutes les classes de ce niveau.
model ListeFournitureClasse {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)

  /// Niveau source (ex: "6ème") — utilisé pour retrouver les demandes
  niveau String

  statut       StatutListeFourniture @default(BROUILLON)
  publieeParId String?
  publieeLe    DateTime?

  items ListeFournitureItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classeId])
  @@index([tenantId])
  @@index([siteId])
  @@index([classeId])
  @@index([niveau])
  @@map("listes_fournitures_classes")
}

/// Item d'une liste de fournitures publiée.
model ListeFournitureItem {
  id      String                @id @default(cuid())
  listeId String
  liste   ListeFournitureClasse @relation(fields: [listeId], references: [id], onDelete: Cascade)

  type        TypeFourniture
  nom         String
  description String?
  quantite    Int            @default(1)
  format      String?
  prixEstime  Float?

  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id], onDelete: SetNull)

  /// Lien vers la demande d'origine (traçabilité)
  sourceDemandeId String?

  @@index([listeId])
  @@index([matiereId])
  @@map("liste_fourniture_items")
}
