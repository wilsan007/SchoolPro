# ============================================================
# EcolPro — Variables d'environnement de production (VPS)
# Copier en .env.production et remplir les valeurs.
# NE JAMAIS committer .env.production dans git.
# ============================================================

# --- Domaine ---
# Le domaine principal qui pointe vers le VPS (A record configuré)
DOMAIN=ecolpro.app
NEXT_PUBLIC_APP_URL=https://ecolpro.app
NEXT_PUBLIC_APP_NAME=EcolPro
# Sous-domaine pour la console MinIO (admin des fichiers)
MINIO_CONSOLE_DOMAIN=minio.ecolpro.app

# --- PostgreSQL ---
# Générer un mot de passe fort : openssl rand -base64 32
POSTGRES_DB=ecolpro
POSTGRES_USER=ecolpro
POSTGRES_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_LONG

# --- Redis ---
# Générer : openssl rand -base64 24
REDIS_PASSWORD=CHANGER_CE_MOT_DE_PASSE_REDIS

# --- MinIO (stockage S3) ---
# MinIO root credentials (admin de la console)
# Générer : openssl rand -hex 16 (user) + openssl rand -base64 32 (password)
MINIO_ROOT_USER=ecolpro-admin
MINIO_ROOT_PASSWORD=CHANGER_CE_MOT_DE_PASSE_MINIO_TRES_LONG
R2_BUCKET_NAME=ecolpro-files
# URL publique pour accéder aux fichiers (via Caddy ou CDN)
NEXT_PUBLIC_R2_PUBLIC_URL=https://files.ecolpro.app

# --- Auth (NextAuth) ---
# Générer : openssl rand -base64 32
AUTH_SECRET=GENERER_UN_SECRET_TRES_LONG_ET_ALEATOIRE
AUTH_URL=https://ecolpro.app

# --- Email (Resend) ---
# Laisser vide pour désactiver l'envoi d'emails
RESEND_API_KEY=
EMAIL_FROM="EcolPro <noreply@ecolpro.app>"

# --- Paiements (Stripe) ---
# Laisser vide pour désactiver les paiements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- SMS / Notifications ---
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Africa's Talking
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=EcolPro
# WhatsApp Business
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=GENERER_UNE_VALEUR_ALEATOIRE   # openssl rand -hex 24
# Telegram
TELEGRAM_BOT_TOKEN=
# Firebase Cloud Messaging (push mobile)
FCM_SERVICE_ACCOUNT=

# --- Sécurité ---
# Secret pour les cron jobs (Authorization: Bearer <CRON_SECRET>)
# Générer : openssl rand -hex 32
CRON_SECRET=
# Secret pour les webhooks SMS entrants
WEBHOOK_SMS_SECRET=

# --- IA (LEARNOS) ---
# OpenRouter / GLM (payant à l'usage)
GLM_API_KEY=
GLM_API_BASE_URL=https://openrouter.ai/api/v1
GLM_MODEL=
# Ollama (local, gratuit — installer sur le VPS séparément)
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma2:2b
# Groq (cloud, palier gratuit)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
