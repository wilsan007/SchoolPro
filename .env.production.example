# ============================================================
# EcolPro — Variables d'environnement de production (VPS)
# Copier en .env.production et remplir les valeurs.
# NE JAMAIS committer .env.production dans git.
# ============================================================

# --- Domaine ---
# Le domaine principal qui pointe vers le VPS (A record configuré)
DOMAIN=ecolpro.app
NEXT_PUBLIC_APP_URL=https://ecolpro.app
NEXT_PUBLIC_APP_NAME=EcolPro
# Sous-domaine pour la console MinIO (admin des fichiers)
MINIO_CONSOLE_DOMAIN=minio.ecolpro.app

# --- PostgreSQL ---
# Un mot de passe DIFFÉRENT par rôle : c'est tout l'intérêt de les avoir
# séparés. Réutiliser le même annulerait le cloisonnement.
#   openssl rand -base64 32   (à répéter pour chacun)
POSTGRES_DB=ecolpro
POSTGRES_USER=postgres

# Superutilisateur — refusé par le réseau (pg_hba), utilisé uniquement par
# l'entrypoint officiel au premier démarrage.
PG_SUPERUSER_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_LONG

# Propriétaire du schéma — DDL, migrations. Conteneur éphémère seulement.
PG_OWNER_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_LONG

# Rôle applicatif — le seul en fonctionnement permanent. Aucun droit DDL,
# et c'est lui que les politiques RLS contraignent.
PG_APP_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_LONG

# Sauvegarde (pgBackRest) — lecture globale + réplication.
PG_BACKUP_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_LONG

# Lecture seule — diagnostic, exports ponctuels.
PG_RO_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_LONG

# Console d'administration PgBouncer.
PGBOUNCER_ADMIN_PASSWORD=CHANGER_CE_MOT_DE_PASSE_TRES_LONG

# Phrase secrète de chiffrement des sauvegardes pgBackRest.
# À CONSERVER HORS DU VPS : sans elle, les sauvegardes sont illisibles —
# y compris pour vous, le jour où le serveur a disparu.
PGBACKREST_CIPHER_PASS=CHANGER_CETTE_PHRASE_SECRETE_TRES_LONGUE

# --- Tunnel Cloudflare ---
# Jeton du tunnel (Dashboard Cloudflare → Zero Trust → Tunnels).
# C'est lui qui fait entrer le trafic sans ouvrir le moindre port.
CLOUDFLARE_TUNNEL_TOKEN=CHANGER_LE_JETON_DU_TUNNEL

# --- Redis ---
# Générer : openssl rand -base64 24
REDIS_PASSWORD=CHANGER_CE_MOT_DE_PASSE_REDIS

# --- MinIO (stockage S3) ---
# MinIO root credentials (admin de la console)
# Générer : openssl rand -hex 16 (user) + openssl rand -base64 32 (password)
MINIO_ROOT_USER=ecolpro-admin
MINIO_ROOT_PASSWORD=CHANGER_CE_MOT_DE_PASSE_MINIO_TRES_LONG
R2_BUCKET_NAME=ecolpro-files
# URL publique pour accéder aux fichiers (via Caddy ou CDN)
NEXT_PUBLIC_R2_PUBLIC_URL=https://files.ecolpro.app

# --- Auth (NextAuth) ---
# Générer : openssl rand -base64 32
AUTH_SECRET=GENERER_UN_SECRET_TRES_LONG_ET_ALEATOIRE
AUTH_URL=https://ecolpro.app

# --- Email (Resend) ---
# Laisser vide pour désactiver l'envoi d'emails
RESEND_API_KEY=
EMAIL_FROM="EcolPro <noreply@ecolpro.app>"

# --- Paiements (Stripe) ---
# Laisser vide pour désactiver les paiements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- SMS / Notifications ---
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Africa's Talking
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=EcolPro
# WhatsApp Business
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=GENERER_UNE_VALEUR_ALEATOIRE   # openssl rand -hex 24
# Telegram
TELEGRAM_BOT_TOKEN=
# Firebase Cloud Messaging (push mobile)
FCM_SERVICE_ACCOUNT=

# --- Sécurité ---
# Secret pour les cron jobs (Authorization: Bearer <CRON_SECRET>)
# Générer : openssl rand -hex 32
# openssl rand -hex 32 — une valeur VIDE fait échouer le démarrage, c'est voulu.
CRON_SECRET=CHANGER_CE_SECRET_DE_TACHES_PLANIFIEES
# Secret pour les webhooks SMS entrants
WEBHOOK_SMS_SECRET=

# --- IA (LEARNOS) ---
# OpenRouter / GLM (payant à l'usage)
GLM_API_KEY=
GLM_API_BASE_URL=https://openrouter.ai/api/v1
GLM_MODEL=
# Ollama (local, gratuit — installer sur le VPS séparément)
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma2:2b
# Groq (cloud, palier gratuit)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# --- Alertes d'exploitation ---
# Identifiant de la conversation Telegram qui reçoit les alertes
# (sauvegarde échouée, audit de sécurité, test de restauration).
# Distinct des notifications aux parents : ce canal est le vôtre.
TELEGRAM_ALERT_CHAT_ID=

# --- Signal de vie externe (dead man's switch) ---------------------------
# Toutes les autres alertes ne parlent qu'en cas d'échec : si le VPS, son
# ordonnanceur ou son accès réseau tombent, il ne part RIEN — et rien
# ressemble à « tout va bien ». Ces URL inversent la logique : la tâche
# signale ses succès, et c'est le service tiers qui alerte en cas de
# silence.
#
# Créer deux « checks » sur healthchecks.io (offre gratuite suffisante) :
# l'un attendu toutes les 6 h (sauvegardes), l'autre chaque semaine (test
# de restauration). Coller ici les URL de ping.
HEARTBEAT_BACKUP_URL=
HEARTBEAT_RESTORE_TEST_URL=

# --- Isolation multi-tenant en base (Row Level Security) ------------------
# off (défaut) | warn (observation) | enforce (bloquant)
# Ne PAS passer directement à enforce : suivre RUNBOOK.md, section
# « Activation de la RLS ». L'ordre des étapes conditionne le bon
# fonctionnement du site.
RLS_MODE=off
