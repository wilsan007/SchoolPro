# ============================================================
# ECOLPRO — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EcolPro
NODE_ENV=development

# --- Base de données PostgreSQL ---
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecolpro?schema=public"

# --- NextAuth / Auth.js ---
AUTH_SECRET="votre-secret-tres-long-et-aleatoire-ici"   # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# --- OAuth (optionnel) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="EcolPro <noreply@ecolpro.app>"

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Stockage fichiers (Cloudflare R2 / AWS S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ecolpro-files
NEXT_PUBLIC_R2_PUBLIC_URL=https://files.ecolpro.app

# --- Paiements (Stripe) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Push Notifications (Firebase Cloud Messaging, API HTTP v1) ---
# Coller le JSON complet du compte de service Firebase (ou sa version base64).
# Couvre Android (FCM) et iOS (APNs via FCM).
FCM_SERVICE_ACCOUNT=

# --- SMS (Africa's Talking) ---
# Docs: https://developers.africastalking.com/docs/sms
# 1. Créer un compte sur https://africastalking.com
# 2. Récupérer API Key et Username dans le dashboard
# 3. En sandbox, utiliser un numéro de test
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=EcolPro

# --- WhatsApp Business Cloud API ---
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
# 1. Créer une app sur https://developers.facebook.com → WhatsApp Business
# 2. Ajouter le produit "WhatsApp" à l'app
# 3. Récupérer le token d'accès permanent et le Phone Number ID
# 4. Pour les tests: utiliser le numéro de test fourni par Meta
# Token d'accès permanent (commence par EAAB...)
WHATSAPP_API_TOKEN=
# ID du numéro WhatsApp Business (visible dans le dashboard Meta)
WHATSAPP_PHONE_NUMBER_ID=
# ID du compte business (optionnel)
WHATSAPP_BUSINESS_ID=

# --- Telegram Bot API ---
# Docs: https://core.telegram.org/bots/api
# 1. Ouvrir Telegram et chercher @BotFather
# 2. Envoyer /newbot et suivre les instructions
# 3. Copier le token fourni par BotFather
# 4. Pour trouver votre chat_id: envoyez /start au bot, puis
#    appelez GET /api/test/telegram?step=chatid
TELEGRAM_BOT_TOKEN=

# --- Mobile (Capacitor) ---
# URL de production vers laquelle pointe la coque native iOS/Android.
CAP_SERVER_URL=https://app.ecolpro.app

# --- Cron (notifications planifiées) ---
# Secret protégeant /api/cron/*. Vercel Cron l'envoie automatiquement.
# Générer : openssl rand -hex 32
CRON_SECRET=

# --- Webhooks entrants (sécurité) ---
# WhatsApp/Meta : App Secret pour vérifier la signature x-hub-signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=ecolpro_whatsapp_token
# Africa's Talking n'a pas de signature : protéger via un secret partagé.
# Configurer l'URL de callback avec ?secret=<valeur>. Générer : openssl rand -hex 16
WEBHOOK_SMS_SECRET=
