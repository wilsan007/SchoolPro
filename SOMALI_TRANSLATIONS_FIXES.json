  "PLURIELS_ET_DÉCLINAISONS": {
    "note": "Le somali utilise des marqueurs grammaticaux pour les pluriels — essentiels à respecter",
    "exemples": {
      "arday → ardayda": { "marker": "-da (collectif)", "meaning": "élève → les élèves" },
      "cutubo → cutubyada": { "marker": "-da (pluriel)", "meaning": "chapitre → chapitres" },
      "awood → awoodaha": { "marker": "-ha (pluriel)", "meaning": "compétence → compétences" },
      "maaddo → maaddooyinka": { "marker": "-yinka (pluriel)", "meaning": "matière → matières" }
    },
    "règle_d_or": "Préférer le pluriel naturel avec marqueur plutôt que la forme neutre (sauf clés génériques)"
  },

